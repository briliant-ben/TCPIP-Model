    "max_prefixes": 128,
    "max_cases": 64
  },
  "scope": {
    "purpose": "Initial IPv4 endpoint header admission descriptor, controller-reviewed multi-agent candidate",
    "assumptions": [
      "Already-local valid-address unfragmented input",
      "header_checksum_valid supplied; no checksum arithmetic",
      "No options: IHL>5 explicitly uncovered"
    ],
    "excluded": [
      "IP options (IHL>5)",
      "fragmentation and reassembly",
      "IP addresses and routing/local delivery decisions",
      "ICMP generation and processing",
      "payload byte content/copying",
      "header checksum arithmetic (header_checksum_valid is a lower-layer fact)",
      "router forwarding and TTL decrement",
      "TCP/UDP transport behavior",
      "wire codec",
      "Complete IPv4 conformance",
      "Unbounded proof or English-to-IR/compiler proof"
    ]
  }
}
