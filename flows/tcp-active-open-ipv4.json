  "limits": {
    "stage_seconds": 120,
    "max_prefixes": 256,
    "max_cases": 64
  },
  "scope": {
    "purpose": "Repeatable selected TCP active-open flow through native IPv4/TCP byte input/output and virtual-link PCAP; event safety remains bounded",
    "assumptions": [
      "Typed validated SYN+ACK input events",
      "Reference-derived finite test domains; source interpretation remains trusted",
      "The controller pins the approved task; modelers change candidate IR, not acceptance sources or seed oracles",
      "RFC791 section3.1 and RFC9293 section3.1 fixed-header representation; one four-tuple, no options/payload/fragments. Codec rejects unsupported shapes without claiming modeled RFC response behavior."
    ],
    "excluded": [
      "payload and general TCP",
      "second-spec migration",
      "unbounded proof or proof of English-to-IR interpretation",
      "General IPv4 host/router behavior, options, fragmentation, physical network and Linux TCP implementation"
    ]
  },
