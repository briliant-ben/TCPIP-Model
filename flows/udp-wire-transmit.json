  },
  "scope": {
    "purpose": "IR-generated actual IPv4/UDP egress bytes; no handwritten protocol codec",
    "assumptions": [
      "Fixed tuple/TTL/atomic ID/MTU profile",
      "PCAP frames actual C bytes on a virtual link; not physical/Linux peer evidence"
    ],
    "excluded": [
      "receive/decode, ARP, ICMP and socket binding",
      "routing/PMTU discovery/options/fragmentation",
      "Linux UDP peer/physical capture",
      "full UDP/IPv4 stack or unbounded correctness proof"
    ]
  }
