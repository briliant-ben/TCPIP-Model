  "scope": {
    "purpose": "Second actual RFC migration through unchanged generic tools; UDP header/service descriptor slice",
    "assumptions": [
      "Prebound receive port8080; fixed validated IPv4 address context",
      "Payload data represented only by length; sum_valid supplied by assumed lower-layer checksum validation",
      "Pinned independent fixture and task controlled by acceptance caller, separate from candidate modeler"
    ],
    "excluded": [
      "payload byte content/copying",
      "UDP/IP wire codec and checksum arithmetic",
      "IPv6 checksum rules",
      "IP address/route/fragmentation/options behavior",
      "port binding lifecycle and ICMP port unreachable",
      "queue/socket API and resource exhaustion",
      "reliability or delivery/duplicate guarantees",
      "UDP PCAP/physical-network evidence",
      "Full UDP compliance",
      "Unbounded proof or English-to-IR/generator correctness proof"
    ]
  }
