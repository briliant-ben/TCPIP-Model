  "scope": {
    "purpose": "One-neighbor ARP endpoint with explicit wire/cache/timers",
    "assumptions": [
      "Fixed local and peer IPv4, MAC first octet02",
      "Raw Ethernet-II42..60, egress60 zero pad, retry1000ms once",
      "Cache TTL configurable60000..3600000"
    ],
    "excluded": [
      "General ARP, pending IP-packet queue and cross-layer forwarding",
      "Real peer/physical capture and unbounded/compiler correctness proof"
    ]
  }
