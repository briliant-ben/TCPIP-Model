{
  "scenario_version": "0.1",
  "id": "receive-fin-with-payload",
  "description": "receive-fin-with-payload",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "MSS=4, unread receive window=16; no tcp_recved/app.read; virtual clock <=200ms; MORE no PSH."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "net.fin_segment",
      "fields": {
        "seq": 9001,
        "ack": 1001,
        "window": 8,
        "data": [
          0,
          128,
          255,
          7
        ]
      }
    }
  ],
  "expect": {
    "state": "CLOSE-WAIT",
    "variables": {
      "rcv_nxt": 9006,
      "rcv_buf": [
        0,
        128,
        255,
        7
      ],
      "rx_fin_done": true
    },
    "timers": {}
  }
}
