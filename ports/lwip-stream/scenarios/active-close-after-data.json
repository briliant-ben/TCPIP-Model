{
  "scenario_version": "0.1",
  "id": "active-close-after-data",
  "description": "active-close-after-data",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "MSS=4, unread receive window=16; no tcp_recved/app.read; virtual clock <=200ms; MORE no PSH."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          128,
          255,
          7
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 30,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1005,
        "window": 8
      }
    },
    {
      "at_ms": 40,
      "event": "app.close",
      "fields": {}
    },
    {
      "at_ms": 50,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1006,
        "window": 8
      }
    },
    {
      "at_ms": 60,
      "event": "net.fin_segment",
      "fields": {
        "seq": 9001,
        "ack": 1006,
        "window": 8,
        "data": []
      }
    }
  ],
  "expect": {
    "state": "TIME-WAIT",
    "variables": {
      "rcv_nxt": 9002,
      "snd_una": 1006,
      "snd_nxt": 1006
    },
    "timers": {
      "time_wait": 120060
    }
  }
}
