{
  "ir_version": "0.2",
  "protocol": "udp-ipv4-header-descriptor",
  "semantics": "flat-efsm-atomic-ordered-v1",
  "scope": {
    "terminal_states": [],
    "excluded": [
      "payload byte content/copying",
      "UDP/IP wire codec and checksum arithmetic",
      "IPv6 checksum rules",
      "IP address/route/fragmentation/options behavior",
      "port binding lifecycle and ICMP port unreachable",
      "queue/socket API and resource exhaustion",
      "reliability or delivery/duplicate guarantees"
    ]
  },
  "states": [
    "READY"
  ],
  "initial_state": "READY",
  "variables": {
    "checksums_enabled": {
      "type": "bool",
      "initial": true
    },
    "tx_count": {
      "type": "int",
      "initial": 0
    },
    "rx_count": {
      "type": "int",
      "initial": 0
    },
    "discard_count": {
      "type": "int",
      "initial": 0
    },
    "last_payload_length": {
      "type": "int",
      "initial": 0
    }
  },
  "events": {
    "app.configure_checksum": {
      "origin": "application",
      "fields": {
        "enabled": "bool"
      }
    },
    "app.send": {
      "origin": "application",
      "fields": {
        "source_port": "int",
        "destination_port": "int",
        "payload_length": "int"
      }
    },
    "net.datagram": {
      "origin": "network",
      "fields": {
        "source_port": "int",
        "destination_port": "int",
        "length": "int",
        "available_length": "int",
        "checksum": "int",
        "sum_valid": "bool"
      }
    }
  },
  "timers": {},
  "messages": {
    "udp.datagram": {
      "fields": {
        "source_port": "int",
        "destination_port": "int",
        "length": "int",
        "checksum_present": "bool"
      }
    },
    "udp.delivery": {
      "fields": {
        "source_port": "int",
        "destination_port": "int",
        "payload_length": "int"
      }
    },
    "udp.error": {
      "fields": {
        "reason": "string"
      }
    }
  },
  "requirements": {
    "UDP-LENGTH": {
      "source": "https://www.rfc-editor.org/rfc/rfc768.txt",
      "interpretation": "Length includes the eight-octet UDP header and data; derive descriptor payload_length=length-8.",
      "strength": "definition",
      "kind": "protocol_interpretation"
    },
    "UDP-SOURCE-PORT": {
      "source": "https://www.rfc-editor.org/rfc/rfc768.txt",
      "interpretation": "Source port zero represents an unused optional source port and is admitted.",
      "strength": "definition",
      "kind": "protocol_interpretation"
    },
    "UDP-CHECKSUM-ZERO": {
      "source": "https://www.rfc-editor.org/rfc/rfc768.txt",
      "interpretation": "A transmitted checksum of zero means checksum absent; this IPv4 profile accepts absent checksums.",
      "strength": "definition",
      "kind": "protocol_interpretation"
    },
    "UDP-CHECKSUM-RECEIVE": {
      "source": "https://www.rfc-editor.org/rfc/rfc1122.txt",
      "interpretation": "A nonzero invalid checksum silently discards the datagram; no delivery or network response is emitted. sum_valid is an explicit lower-layer validation fact, not a proved checksum algorithm.",
      "strength": "MUST",
      "kind": "protocol_interpretation"
    },
    "UDP-CHECKSUM-DEFAULT": {
      "source": "https://www.rfc-editor.org/rfc/rfc1122.txt",
      "interpretation": "Checksum generation defaults on; this profile supports optional application configuration of checksum generation.",
      "strength": "MUST/MAY",
      "kind": "protocol_interpretation"
    },
    "UDP-INTERFACE": {
      "source": "https://www.rfc-editor.org/rfc/rfc768.txt",
      "interpretation": "Send/receive descriptors preserve source/destination ports and payload length; byte content and IP addresses are abstracted by the selected fixed-address profile.",
      "strength": "SHOULD",
      "kind": "protocol_interpretation"
    },
    "UDP-PROFILE": {
      "source": "docs/udp-header-flow.md",
      "interpretation": "Bound local receive port8080 and validated IPv4 metadata; available_length0..65515, ports16bit; no IP options/fragmentation. Invalid lengths silently discard as the selected parser profile; oversized local sends produce a local error. Wrong local ports and impossible typed header fields remain model gaps, not an ICMP/drop claim.",
      "strength": "assumption",
      "kind": "environment_assumption"
    }
  },
