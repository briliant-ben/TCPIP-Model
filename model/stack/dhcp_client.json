{
  "ir_version": "0.6",
  "semantics": "flat-efsm-atomic-ordered-v1",
  "protocol": "dhcpv4-client",
  "scope": {
    "terminal_states": [],
    "excluded": [
      "dhcp_server",
      "dhcp_relay"
    ]
