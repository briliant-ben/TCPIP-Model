  "initial_state": "INIT",
  "requirements": {
    "CTRL.DHCP": {
      "source": "spec/stack/ctrl-dhcp-dns.md#2",
      "interpretation": "DORA lifecycle, retries, lease bounds, and timer ownership."
    }
