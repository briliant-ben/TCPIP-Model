        {
          "set": {
            "var": "retries",
            "value": 0
          }
        },
        {
          "set": {
            "var": "lease_s",
            "value": 0
          }
        },
        {
          "arm": {
            "timer": "retry_tmo",
            "delay_ms": 1000
          }
        }
