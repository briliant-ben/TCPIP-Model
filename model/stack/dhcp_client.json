      "origin": "network",
      "fields": {}
    },
    "rx_ack": {
      "origin": "network",
      "fields": {
        "lease": "int"
      }
    },
    "rx_nak": {
      "origin": "network",
      "fields": {}
    },
    "stop": {
      "origin": "application",
      "fields": {}
    },
