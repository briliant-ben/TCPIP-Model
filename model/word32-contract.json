{
  "ir_version": "0.6",
  "semantics": "flat-efsm-atomic-ordered-v1",
  "protocol": "word32-packing-contract",
  "scope": {
    "terminal_states": [],
    "excluded": [
      "Protocol field admission, TCP/IP state and wire layout",
      "Network/PCAP observations",
      "Unbounded compiler or protocol proof"
    ]
  },
  "states": [
    "READY"
  ],
  "initial_state": "READY",
  "variables": {
    "packed": {
      "type": "bytes",
      "initial": [
        0,
        0,
        0,
        0
      ]
    }
  },
  "events": {
    "pack": {
      "origin": "application",
      "fields": {
        "value": "int"
      }
    }
  },
  "timers": {},
  "messages": {
    "word32.result": {
      "fields": {
        "packed": "bytes"
      }
    }
  },
  "requirements": {
    "WORD32-PACK": {
      "source": "docs/word32-packing.md",
      "kind": "modeling_choice",
      "strength": "exact total value",
      "interpretation": "Four big-endian octets of value modulo 2^32. This pure arithmetic is not uint32 field admission."
    }
  },
  "transitions": [
    {
      "id": "PACK",
      "from": "READY",
      "to": "READY",
      "event": "pack",
      "guard": true,
      "requirements": [
        "WORD32-PACK"
      ],
      "actions": [
        {
          "set": {
            "var": "packed",
            "value": {
              "op": "bytes_pack32be_mod",
              "args": [
                {
                  "event": "value"
                }
              ]
            }
          }
        },
        {
          "emit": {
            "message": "word32.result",
            "fields": {
              "packed": {
                "var": "packed"
              }
            }
          }
        }
      ]
    }
  ],
  "invariants": [
    {
      "id": "PACKED-FOUR",
      "requirements": [
        "WORD32-PACK"
      ],
      "assert": {
        "op": "eq",
        "args": [
          {
            "op": "bytes_len",
            "args": [
              {
                "var": "packed"
              }
            ]
          },
          4
        ]
      }
    }
  ]
}
