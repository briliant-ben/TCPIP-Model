{
  "ir_version": "0.2",
  "semantics": "flat-efsm-atomic-ordered-v1",
  "protocol": "udp-ipv4-payload-descriptor",
  "scope": {
    "terminal_states": [],
    "excluded": [
      "Wire format encoding/decoding, checksum arithmetic, pseudo-header computation",
      "PCAP capture, full UDP stack integration, IP layer behavior",
      "ICMP port-unreachable generation for unbound ports (explicit modeling gap)",
      "TCP transitions, network execution, output and timing semantics",
      "universal Python interpreter or Z3 translator correspondence",
      "Complete UDP/IPv4 endpoint conformance",
      "All-input unbounded proof, compiler correctness and English-to-IR proof"
    ]
  },
  "states": [
    "READY"
  ],
  "initial_state": "READY",
  "variables": {
    "checksums_enabled": {
      "type": "bool",
      "initial": true
    },
    "last_data": {
      "type": "bytes",
      "initial": []
    }
  },
  "events": {
    "app.configure_checksum": {
      "origin": "application",
      "fields": {
        "enabled": "bool"
      }
    },
    "app.send": {
      "origin": "application",
      "fields": {
        "source_port": "int",
        "destination_port": "int",
        "data": "bytes"
      }
    },
    "net.datagram": {
      "origin": "network",
      "fields": {
        "source_port": "int",
        "destination_port": "int",
        "length": "int",
        "checksum": "int",
        "sum_valid": "bool",
        "data": "bytes"
      }
    }
  },
  "timers": {},
  "messages": {
    "udp.send": {
      "fields": {
        "source_port": "int",
        "destination_port": "int",
        "length": "int",
        "checksum_enabled": "bool",
        "data": "bytes"
      }
    },
    "udp.delivery": {
      "fields": {
        "source_port": "int",
        "destination_port": "int",
        "data": "bytes"
      }
    }
  },
  "requirements": {
    "UDP-LENGTH": {
      "source": "https://www.rfc-editor.org/rfc/rfc768.txt",
      "interpretation": "RFC768 Fields page2: UDP length includes the8-octet header and payload; minimum8. This model delivers precisely length-8 octets and excludes IP padding.",
      "strength": "definition",
      "kind": "protocol_interpretation"
    },
    "UDP-SOURCE-PORT": {
      "source": "https://www.rfc-editor.org/rfc/rfc768.txt",
      "interpretation": "RFC 768 'Fields' section (page 1): 'Source Port is an optional field ... If not used, a value of zero is inserted.' Source port zero represents an unused optional source port and is admitted.",
      "strength": "definition",
      "kind": "protocol_interpretation"
    },
    "UDP-CHECKSUM-ZERO": {
      "source": "https://www.rfc-editor.org/rfc/rfc768.txt",
      "interpretation": "RFC 768 'Fields/Checksum' (page 2): 'An all zero transmitted checksum value means that the transmitter generated no checksum.' A transmitted checksum of zero means checksum absent; this IPv4 profile accepts absent checksums.",
      "strength": "definition",
      "kind": "protocol_interpretation"
    },
    "UDP-CHECKSUM-RECEIVE": {
      "source": "https://www.rfc-editor.org/rfc/rfc1122.txt",
      "interpretation": "RFC 1122 section 4.1.3.4 'UDP Checksums' (page 78): 'If a UDP datagram is received with a checksum that is non-zero and invalid, UDP MUST silently discard the datagram.' A nonzero invalid checksum silently discards the datagram; no delivery or network response is emitted. sum_valid is an explicit lower-layer validation fact, not a proved checksum algorithm.",
      "strength": "MUST",
      "kind": "protocol_interpretation"
    },
    "UDP-CHECKSUM-DEFAULT": {
      "source": "https://www.rfc-editor.org/rfc/rfc1122.txt",
      "interpretation": "RFC 1122 section 4.1.3.4 'UDP Checksums' (page 78): 'An application MAY optionally be able to control whether a UDP checksum will be generated, but it MUST default to checksumming on.' Checksum generation defaults on; this profile supports optional application configuration of checksum generation.",
      "strength": "MUST/MAY",
      "kind": "protocol_interpretation"
    },
    "UDP-INTERFACE": {
      "source": "https://www.rfc-editor.org/rfc/rfc768.txt",
      "interpretation": "RFC768 User Interface page2: send/receive service preserves actual data octets and ports. Payload bytes are explicit here; fixed validated IP addresses are an input-context assumption. Address delivery requirements are outside this slice.",
      "strength": "SHOULD",
      "kind": "protocol_interpretation"
    },
    "UDP-PAYLOAD-PROFILE": {
      "source": "docs/udp-payload-flow.md",
      "kind": "modeling_choice",
      "strength": "finite profile",
      "interpretation": "Fixed READY service slice, receive port8080, uint16 metadata and at most4096 data octets. Invalid metadata is uncovered, invalid UDP length discarded. Unbound-port discard is a temporary explicit profile gap; no ICMP implementation or full UDP claim. sum_valid is supplied, not computed."
    }
  },
  "transitions": [
    {
      "id": "CONFIGURE-CHECKSUM",
      "from": "READY",
      "to": "READY",
      "event": "app.configure_checksum",
      "guard": true,
      "requirements": [
        "UDP-CHECKSUM-DEFAULT",
        "UDP-PAYLOAD-PROFILE"
      ],
      "actions": [
        {
          "set": {
            "var": "checksums_enabled",
            "value": {
              "event": "enabled"
            }
          }
        }
      ]
    },
    {
      "id": "APP-SEND",
      "from": "READY",
      "to": "READY",
      "event": "app.send",
      "guard": {
        "op": "and",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "op": "ge",
                "args": [
                  {
                    "event": "source_port"
                  },
                  0
                ]
              },
              {
                "op": "le",
                "args": [
                  {
                    "event": "source_port"
                  },
                  65535
                ]
              }
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "ge",
                    "args": [
                      {
                        "event": "destination_port"
                      },
                      0
                    ]
                  },
                  {
                    "op": "le",
                    "args": [
                      {
                        "event": "destination_port"
                      },
                      65535
                    ]
                  }
                ]
              },
              {
                "op": "le",
                "args": [
                  {
                    "op": "bytes_len",
                    "args": [
                      {
                        "event": "data"
                      }
                    ]
                  },
                  4096
                ]
              }
            ]
          }
        ]
      },
      "requirements": [
        "UDP-LENGTH",
        "UDP-SOURCE-PORT",
        "UDP-INTERFACE",
        "UDP-PAYLOAD-PROFILE"
      ],
      "actions": [
        {
          "emit": {
            "message": "udp.send",
            "fields": {
              "source_port": {
                "event": "source_port"
              },
              "destination_port": {
                "event": "destination_port"
              },
              "length": {
                "op": "add",
                "args": [
                  8,
                  {
                    "op": "bytes_len",
                    "args": [
                      {
                        "event": "data"
                      }
                    ]
                  }
                ]
              },
              "checksum_enabled": {
                "var": "checksums_enabled"
              },
              "data": {
                "event": "data"
              }
            }
          }
        }
      ]
    },
    {
      "id": "NET-DELIVER",
      "from": "READY",
      "to": "READY",
      "event": "net.datagram",
      "guard": {
        "op": "and",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "ge",
                    "args": [
                      {
                        "event": "source_port"
                      },
                      0
                    ]
                  },
                  {
                    "op": "le",
                    "args": [
                      {
                        "event": "source_port"
                      },
                      65535
                    ]
                  }
                ]
              },
              {
                "op": "and",
                "args": [
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "ge",
                        "args": [
                          {
                            "event": "destination_port"
                          },
                          0
                        ]
                      },
                      {
                        "op": "le",
                        "args": [
                          {
                            "event": "destination_port"
                          },
                          65535
                        ]
                      }
                    ]
                  },
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "and",
                        "args": [
                          {
                            "op": "ge",
                            "args": [
                              {
                                "event": "length"
                              },
                              0
                            ]
                          },
                          {
                            "op": "le",
                            "args": [
                              {
                                "event": "length"
                              },
                              65535
                            ]
                          }
                        ]
                      },
                      {
                        "op": "and",
                        "args": [
                          {
                            "op": "and",
                            "args": [
                              {
                                "op": "ge",
                                "args": [
                                  {
                                    "event": "checksum"
                                  },
                                  0
                                ]
                              },
                              {
                                "op": "le",
                                "args": [
                                  {
                                    "event": "checksum"
                                  },
                                  65535
                                ]
                              }
                            ]
                          },
                          {
                            "op": "le",
                            "args": [
                              {
                                "op": "bytes_len",
                                "args": [
                                  {
                                    "event": "data"
                                  }
                                ]
                              },
                              4096
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "event": "destination_port"
                      },
                      8080
                    ]
                  },
                  {
                    "op": "ge",
                    "args": [
                      {
                        "event": "length"
                      },
                      8
                    ]
                  }
                ]
              },
              {
                "op": "and",
                "args": [
                  {
                    "op": "le",
                    "args": [
                      {
                        "event": "length"
                      },
                      {
                        "op": "add",
                        "args": [
                          8,
                          {
                            "op": "bytes_len",
                            "args": [
                              {
                                "event": "data"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "or",
                    "args": [
                      {
                        "op": "eq",
                        "args": [
                          {
                            "event": "checksum"
                          },
                          0
                        ]
                      },
                      {
                        "event": "sum_valid"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "requirements": [
        "UDP-LENGTH",
        "UDP-CHECKSUM-ZERO",
        "UDP-CHECKSUM-RECEIVE",
        "UDP-INTERFACE",
        "UDP-PAYLOAD-PROFILE"
      ],
      "actions": [
        {
          "set": {
            "var": "last_data",
            "value": {
              "op": "bytes_slice",
              "args": [
                {
                  "event": "data"
                },
                0,
                {
                  "op": "sub",
                  "args": [
                    {
                      "event": "length"
                    },
                    8
                  ]
                }
              ]
            }
          }
        },
        {
          "emit": {
            "message": "udp.delivery",
            "fields": {
              "source_port": {
                "event": "source_port"
              },
              "destination_port": {
                "event": "destination_port"
              },
              "data": {
                "var": "last_data"
              }
            }
          }
        }
      ]
    },
    {
      "id": "NET-DISCARD",
      "from": "READY",
      "to": "READY",
      "event": "net.datagram",
      "guard": {
        "op": "and",
        "args": [
          {
            "op": "and",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "ge",
                    "args": [
                      {
                        "event": "source_port"
                      },
                      0
                    ]
                  },
                  {
                    "op": "le",
                    "args": [
                      {
                        "event": "source_port"
                      },
                      65535
                    ]
                  }
                ]
              },
              {
                "op": "and",
                "args": [
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "ge",
                        "args": [
                          {
                            "event": "destination_port"
                          },
                          0
                        ]
                      },
                      {
                        "op": "le",
                        "args": [
                          {
                            "event": "destination_port"
                          },
                          65535
                        ]
                      }
                    ]
                  },
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "and",
                        "args": [
                          {
                            "op": "ge",
                            "args": [
                              {
                                "event": "length"
                              },
                              0
                            ]
                          },
                          {
                            "op": "le",
                            "args": [
                              {
                                "event": "length"
                              },
                              65535
                            ]
                          }
                        ]
                      },
                      {
                        "op": "and",
                        "args": [
                          {
                            "op": "and",
                            "args": [
                              {
                                "op": "ge",
                                "args": [
                                  {
                                    "event": "checksum"
                                  },
                                  0
                                ]
                              },
                              {
                                "op": "le",
                                "args": [
                                  {
                                    "event": "checksum"
                                  },
                                  65535
                                ]
                              }
                            ]
                          },
                          {
                            "op": "le",
                            "args": [
                              {
                                "op": "bytes_len",
                                "args": [
                                  {
                                    "event": "data"
                                  }
                                ]
                              },
                              4096
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "not",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "eq",
                        "args": [
                          {
                            "event": "destination_port"
                          },
                          8080
                        ]
                      },
                      {
                        "op": "ge",
                        "args": [
                          {
                            "event": "length"
                          },
                          8
                        ]
                      }
                    ]
                  },
                  {
                    "op": "and",
                    "args": [
                      {
                        "op": "le",
                        "args": [
                          {
                            "event": "length"
                          },
                          {
                            "op": "add",
                            "args": [
                              8,
                              {
                                "op": "bytes_len",
                                "args": [
                                  {
                                    "event": "data"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "op": "or",
                        "args": [
                          {
                            "op": "eq",
                            "args": [
                              {
                                "event": "checksum"
                              },
                              0
                            ]
                          },
                          {
                            "event": "sum_valid"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "requirements": [
        "UDP-CHECKSUM-RECEIVE",
        "UDP-PAYLOAD-PROFILE"
      ],
      "actions": []
    }
  ],
  "invariants": [
    {
      "id": "LAST-DATA-BOUND",
      "requirements": [
        "UDP-PAYLOAD-PROFILE"
      ],
      "assert": {
        "op": "le",
        "args": [
          {
            "op": "bytes_len",
            "args": [
