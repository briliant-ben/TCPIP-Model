{
  "ir_version": "0.4",
  "semantics": "flat-efsm-atomic-ordered-v1",
  "protocol": "udp-ipv4-wire-transmit",
  "scope": {
    "terminal_states": [],
    "excluded": [
      "receive/decode, ARP, ICMP and socket binding",
      "routing/PMTU discovery/options/fragmentation",
      "Linux UDP peer/physical capture",
      "full UDP/IPv4 stack or unbounded correctness proof"
    ]
  },
  "states": [
    "READY"
  ],
  "initial_state": "READY",
  "variables": {
    "checksums_enabled": {
      "type": "bool",
      "initial": true
    },
    "payload": {
      "type": "bytes",
      "initial": []
    },
    "udp_zero": {
      "type": "bytes",
      "initial": []
    },
    "pseudoheader": {
      "type": "bytes",
      "initial": []
    },
    "udp_wire": {
      "type": "bytes",
      "initial": []
    },
    "ip_zero": {
      "type": "bytes",
      "initial": []
    },
    "ip_wire": {
      "type": "bytes",
      "initial": []
    },
    "packet": {
      "type": "bytes",
      "initial": []
    },
    "udp_length": {
      "type": "int",
      "initial": 0
    },
    "ip_length": {
      "type": "int",
      "initial": 0
    },
    "udp_raw_checksum": {
      "type": "int",
      "initial": 0
    },
    "udp_checksum": {
      "type": "int",
      "initial": 0
    },
    "ip_checksum": {
      "type": "int",
      "initial": 0
    }
  },
  "events": {
    "app.configure_checksum": {
      "origin": "application",
      "fields": {
        "enabled": "bool"
      }
    },
    "app.send": {
      "origin": "application",
      "fields": {
        "data": "bytes"
      }
    }
  },
  "messages": {
    "ipv4.tx": {
      "fields": {
        "packet": "bytes"
      }
    }
  },
  "timers": {},
  "requirements": {
    "UDP-WIRE": {
      "source": "https://www.rfc-editor.org/rfc/rfc768.txt",
      "interpretation": "Fields pages1/2: UDP header network octet layout, length includes8-byte header, IPv4 pseudoheader12 bytes, odd-byte padding only for checksum and transmit computed zero represented as65535.",
      "kind": "protocol_interpretation",
      "strength": "wire definition"
    },
    "UDP-DEFAULT": {
      "source": "https://www.rfc-editor.org/rfc/rfc1122.txt",
      "interpretation": "4.1.3.4: checksum generation defaults on with application configuration permitted.",
      "kind": "protocol_interpretation",
      "strength": "MUST/MAY"
    },
    "IP-WIRE": {
      "source": "https://www.rfc-editor.org/rfc/rfc791.txt",
      "interpretation": "3.1: version/IHL, total length, flags/fragment offset, TTL, protocol17, header checksum and source/destination layout.",
      "kind": "protocol_interpretation",
      "strength": "header definition"
    },
    "ATOMIC-ID": {
      "source": "https://www.rfc-editor.org/rfc/rfc6864.txt",
      "interpretation": "4/4.1: DF1,MF0,offset0 datagrams are atomic; their ID may have any value. This slice chooses0.",
      "kind": "protocol_interpretation",
      "strength": "MAY"
    },
    "PROFILE": {
      "source": "docs/udp-wire-transmit.md",
      "interpretation": "Fixed local documentation-address pair and ports40000/8080, TTL64, DF1, ID0, no options/fragments; data<=1472 fits assumed MTU1500. Transmit only, no routing/ARP/receive/ICMP/physical peer.",
      "kind": "modeling_choice",
      "strength": "finite transmit profile"
    }
  },
  "transitions": [
    {
      "id": "CONFIGURE",
      "from": "READY",
      "to": "READY",
      "event": "app.configure_checksum",
      "guard": true,
      "requirements": [
        "UDP-DEFAULT"
      ],
      "actions": [
        {
          "set": {
            "var": "checksums_enabled",
            "value": {
              "event": "enabled"
            }
          }
        }
      ]
    },
    {
      "id": "TRANSMIT",
      "from": "READY",
      "to": "READY",
      "event": "app.send",
      "guard": {
        "op": "le",
        "args": [
          {
            "op": "bytes_len",
            "args": [
              {
                "event": "data"
              }
            ]
          },
          1472
        ]
      },
      "requirements": [
        "UDP-WIRE",
        "UDP-DEFAULT",
        "IP-WIRE",
        "ATOMIC-ID",
        "PROFILE"
      ],
      "actions": [
        {
          "set": {
            "var": "payload",
            "value": {
              "event": "data"
            }
          }
        },
        {
          "set": {
            "var": "udp_length",
            "value": {
              "op": "add",
              "args": [
                8,
                {
                  "op": "bytes_len",
                  "args": [
                    {
                      "var": "payload"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "set": {
            "var": "ip_length",
            "value": {
              "op": "add",
              "args": [
                20,
                {
                  "var": "udp_length"
                }
              ]
            }
          }
        },
        {
          "set": {
            "var": "udp_zero",
            "value": {
              "op": "bytes_concat",
              "args": [
                {
                  "op": "bytes_concat",
                  "args": [
                    {
                      "op": "bytes_concat",
                      "args": [
                        {
                          "op": "bytes_concat",
                          "args": [
                            {
                              "op": "bytes_pack16be_mod",
                              "args": [
                                40000
                              ]
                            },
                            {
                              "op": "bytes_pack16be_mod",
                              "args": [
                                8080
                              ]
                            }
                          ]
                        },
                        {
                          "op": "bytes_pack16be_mod",
                          "args": [
                            {
                              "var": "udp_length"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "bytes": [
                        0,
                        0
                      ]
                    }
                  ]
                },
                {
                  "var": "payload"
                }
              ]
            }
          }
        },
        {
          "set": {
            "var": "pseudoheader",
            "value": {
              "op": "bytes_concat",
              "args": [
                {
                  "op": "bytes_concat",
                  "args": [
                    {
                      "op": "bytes_concat",
                      "args": [
                        {
                          "bytes": [
                            192,
                            0,
                            2,
                            1
                          ]
                        },
                        {
                          "bytes": [
                            192,
                            0,
                            2,
                            2
                          ]
                        }
                      ]
                    },
                    {
                      "bytes": [
                        0,
                        17
                      ]
                    }
                  ]
                },
                {
                  "op": "bytes_pack16be_mod",
                  "args": [
                    {
                      "var": "udp_length"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "set": {
            "var": "udp_raw_checksum",
            "value": {
              "op": "bytes_internet_checksum16",
              "args": [
                {
                  "op": "bytes_concat",
                  "args": [
                    {
                      "var": "pseudoheader"
                    },
                    {
                      "var": "udp_zero"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "set": {
            "var": "udp_checksum",
            "value": {
              "op": "ite",
              "args": [
                {
                  "var": "checksums_enabled"
                },
                {
                  "op": "ite",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "var": "udp_raw_checksum"
                        },
                        0
                      ]
                    },
                    65535,
                    {
                      "var": "udp_raw_checksum"
                    }
                  ]
                },
                0
              ]
            }
          }
        },
        {
          "set": {
            "var": "udp_wire",
            "value": {
              "op": "bytes_concat",
              "args": [
                {
                  "op": "bytes_concat",
                  "args": [
                    {
                      "op": "bytes_slice",
                      "args": [
                        {
                          "var": "udp_zero"
                        },
                        0,
                        6
                      ]
                    },
                    {
                      "op": "bytes_pack16be_mod",
                      "args": [
                        {
                          "var": "udp_checksum"
                        }
                      ]
                    }
                  ]
                },
                {
                  "var": "payload"
                }
              ]
            }
          }
        },
        {
          "set": {
            "var": "ip_zero",
            "value": {
              "op": "bytes_concat",
              "args": [
                {
                  "op": "bytes_concat",
                  "args": [
                    {
                      "op": "bytes_concat",
                      "args": [
                        {
                          "op": "bytes_concat",
                          "args": [
                            {
                              "bytes": [
                                69,
                                0
                              ]
                            },
                            {
                              "op": "bytes_pack16be_mod",
                              "args": [
                                {
                                  "var": "ip_length"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "bytes": [
                            0,
                            0,
                            64,
                            0,
                            64,
                            17,
                            0,
                            0
                          ]
                        }
                      ]
                    },
                    {
                      "bytes": [
                        192,
                        0,
                        2,
                        1
                      ]
                    }
                  ]
                },
                {
                  "bytes": [
                    192,
                    0,
                    2,
                    2
                  ]
                }
              ]
            }
          }
        },
        {
          "set": {
            "var": "ip_checksum",
            "value": {
              "op": "bytes_internet_checksum16",
              "args": [
                {
                  "var": "ip_zero"
                }
              ]
            }
          }
        },
        {
          "set": {
            "var": "ip_wire",
            "value": {
              "op": "bytes_concat",
              "args": [
                {
                  "op": "bytes_concat",
                  "args": [
                    {
                      "op": "bytes_slice",
                      "args": [
                        {
                          "var": "ip_zero"
                        },
                        0,
                        10
                      ]
                    },
                    {
                      "op": "bytes_pack16be_mod",
                      "args": [
                        {
                          "var": "ip_checksum"
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "bytes_slice",
                  "args": [
                    {
                      "var": "ip_zero"
                    },
                    12,
                    8
                  ]
                }
              ]
            }
          }
        },
        {
          "set": {
            "var": "packet",
            "value": {
              "op": "bytes_concat",
              "args": [
                {
                  "var": "ip_wire"
                },
                {
                  "var": "udp_wire"
                }
              ]
            }
          }
        },
        {
          "emit": {
            "message": "ipv4.tx",
            "fields": {
              "packet": {
                "var": "packet"
              }
            }
          }
        }
      ]
    }
  ],
  "invariants": [
    {
      "id": "PACKET-MTU",
      "requirements": [
        "PROFILE"
      ],
      "assert": {
        "op": "le",
        "args": [
          {
            "op": "bytes_len",
            "args": [
              {
                "var": "packet"
              }
            ]
          },
          1500
        ]
      }
    },
    {
      "id": "PACKET-LENGTH",
      "requirements": [
        "IP-WIRE",
        "UDP-WIRE"
      ],
      "assert": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "op": "bytes_len",
                "args": [
                  {
                    "var": "packet"
                  }
                ]
              },
              0
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "op": "bytes_len",
                "args": [
                  {
                    "var": "packet"
                  }
                ]
              },
              {
                "var": "ip_length"
              }
            ]
          }
        ]
      }
    }
  ]
}
