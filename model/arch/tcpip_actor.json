{
  "ir_version": "0.6",
  "semantics": "flat-efsm-atomic-ordered-v1",
  "protocol": "arch-tcpip-actor",
  "states": ["STOPPED", "IDLE", "HANDLING_RX", "HANDLING_API", "HANDLING_TIMER"],
  "initial_state": "STOPPED",
  "scope": {
    "terminal_states": [],
    "excluded": ["os-scheduler-fairness"]
  },
  "requirements": {
    "TCPIP_ACTOR": {
      "source": "spec/arch/tcpip-actor.md#scope",
      "interpretation": "Single-writer tcpip_thread core lock ownership and API reply liveness."
    }
  },
  "variables": {
    "pending_rx": {"type": "int", "initial": 0},
    "pending_api": {"type": "int", "initial": 0},
    "core_locked": {"type": "bool", "initial": false},
    "reply_pending": {"type": "bool", "initial": false}
  },
  "events": {
    "actor.start": {"origin": "application", "fields": {}},
    "actor.post_rx": {"origin": "application", "fields": {}},
    "actor.post_api": {"origin": "application", "fields": {}},
    "actor.dispatch": {"origin": "application", "fields": {}},
    "actor.complete": {"origin": "application", "fields": {}},
    "actor.stop": {"origin": "application", "fields": {}}
  },
  "messages": {
    "actor.started": {"fields": {}},
    "actor.rx_begin": {"fields": {"pending_rx": "int"}},
    "actor.api_begin": {"fields": {"pending_api": "int"}},
    "actor.timer_begin": {"fields": {}},
    "actor.reply_post": {"fields": {}},
    "actor.done": {"fields": {}},
    "actor.stopped": {"fields": {}}
  },
  "timers": {},
  "invariants": [
    {
      "id": "ACTOR_MUTEX",
      "assert": {
        "op": "or",
        "args": [
          {"op": "and", "args": [{"op": "or", "args": [{"state": "STOPPED"}, {"state": "IDLE"}]}, {"op": "not", "args": [{"var": "core_locked"}]}]},
          {"op": "and", "args": [
            {"op": "or", "args": [{"state": "HANDLING_RX"}, {"op": "or", "args": [{"state": "HANDLING_API"}, {"state": "HANDLING_TIMER"}]}]},
            {"var": "core_locked"}
          ]}
        ]
      },
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR_REPLY_LIVENESS",
      "assert": {"op": "implies", "args": [{"var": "reply_pending"}, {"state": "HANDLING_API"}]},
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR_QUEUE_BOUNDS",
      "assert": {
        "op": "and",
        "args": [
          {"op": "and", "args": [{"op": "le", "args": [0, {"var": "pending_rx"}]}, {"op": "le", "args": [{"var": "pending_rx"}, 128]}]},
          {"op": "and", "args": [{"op": "le", "args": [0, {"var": "pending_api"}]}, {"op": "le", "args": [{"var": "pending_api"}, 64]}]}
        ]
      },
      "requirements": ["TCPIP_ACTOR"]
    }
  ],
  "transitions": [
    {
      "id": "ACTOR.START",
      "from": "STOPPED",
      "to": "IDLE",
      "event": "actor.start",
      "guard": true,
      "actions": [
        {"set": {"var": "pending_rx", "value": 0}},
        {"set": {"var": "pending_api", "value": 0}},
        {"set": {"var": "core_locked", "value": false}},
        {"set": {"var": "reply_pending", "value": false}},
        {"emit": {"message": "actor.started", "fields": {}}}
      ],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.POST_RX_IDLE",
      "from": "IDLE",
      "to": "IDLE",
      "event": "actor.post_rx",
      "guard": {"op": "le", "args": [{"var": "pending_rx"}, 127]},
      "actions": [{"set": {"var": "pending_rx", "value": {"op": "add", "args": [{"var": "pending_rx"}, 1]}}}],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.POST_RX_IN_RX",
      "from": "HANDLING_RX",
      "to": "HANDLING_RX",
      "event": "actor.post_rx",
      "guard": {"op": "le", "args": [{"var": "pending_rx"}, 127]},
      "actions": [{"set": {"var": "pending_rx", "value": {"op": "add", "args": [{"var": "pending_rx"}, 1]}}}],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.POST_RX_IN_API",
      "from": "HANDLING_API",
      "to": "HANDLING_API",
      "event": "actor.post_rx",
      "guard": {"op": "le", "args": [{"var": "pending_rx"}, 127]},
      "actions": [{"set": {"var": "pending_rx", "value": {"op": "add", "args": [{"var": "pending_rx"}, 1]}}}],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.POST_RX_IN_TMR",
      "from": "HANDLING_TIMER",
      "to": "HANDLING_TIMER",
      "event": "actor.post_rx",
      "guard": {"op": "le", "args": [{"var": "pending_rx"}, 127]},
      "actions": [{"set": {"var": "pending_rx", "value": {"op": "add", "args": [{"var": "pending_rx"}, 1]}}}],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.POST_API_IDLE",
      "from": "IDLE",
      "to": "IDLE",
      "event": "actor.post_api",
      "guard": {"op": "le", "args": [{"var": "pending_api"}, 63]},
      "actions": [{"set": {"var": "pending_api", "value": {"op": "add", "args": [{"var": "pending_api"}, 1]}}}],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.POST_API_IN_RX",
      "from": "HANDLING_RX",
      "to": "HANDLING_RX",
      "event": "actor.post_api",
      "guard": {"op": "le", "args": [{"var": "pending_api"}, 63]},
      "actions": [{"set": {"var": "pending_api", "value": {"op": "add", "args": [{"var": "pending_api"}, 1]}}}],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.POST_API_IN_API",
      "from": "HANDLING_API",
      "to": "HANDLING_API",
      "event": "actor.post_api",
      "guard": {"op": "le", "args": [{"var": "pending_api"}, 63]},
      "actions": [{"set": {"var": "pending_api", "value": {"op": "add", "args": [{"var": "pending_api"}, 1]}}}],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.POST_API_IN_TMR",
      "from": "HANDLING_TIMER",
      "to": "HANDLING_TIMER",
      "event": "actor.post_api",
      "guard": {"op": "le", "args": [{"var": "pending_api"}, 63]},
      "actions": [{"set": {"var": "pending_api", "value": {"op": "add", "args": [{"var": "pending_api"}, 1]}}}],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.DISPATCH_RX",
      "from": "IDLE",
      "to": "HANDLING_RX",
      "event": "actor.dispatch",
      "guard": {"op": "ge", "args": [{"var": "pending_rx"}, 1]},
      "actions": [
        {"set": {"var": "pending_rx", "value": {"op": "sub", "args": [{"var": "pending_rx"}, 1]}}},
        {"set": {"var": "core_locked", "value": true}},
        {"emit": {"message": "actor.rx_begin", "fields": {"pending_rx": {"var": "pending_rx"}}}}
      ],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.DISPATCH_API",
      "from": "IDLE",
      "to": "HANDLING_API",
      "event": "actor.dispatch",
      "guard": {"op": "and", "args": [{"op": "eq", "args": [{"var": "pending_rx"}, 0]}, {"op": "ge", "args": [{"var": "pending_api"}, 1]}]},
      "actions": [
        {"set": {"var": "pending_api", "value": {"op": "sub", "args": [{"var": "pending_api"}, 1]}}},
        {"set": {"var": "core_locked", "value": true}},
        {"set": {"var": "reply_pending", "value": true}},
        {"emit": {"message": "actor.api_begin", "fields": {"pending_api": {"var": "pending_api"}}}}
      ],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.DISPATCH_TIMER",
      "from": "IDLE",
      "to": "HANDLING_TIMER",
      "event": "actor.dispatch",
      "guard": {"op": "and", "args": [{"op": "eq", "args": [{"var": "pending_rx"}, 0]}, {"op": "eq", "args": [{"var": "pending_api"}, 0]}]},
      "actions": [
        {"set": {"var": "core_locked", "value": true}},
        {"emit": {"message": "actor.timer_begin", "fields": {}}}
      ],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.COMPLETE_RX",
      "from": "HANDLING_RX",
      "to": "IDLE",
      "event": "actor.complete",
      "guard": true,
      "actions": [
        {"set": {"var": "core_locked", "value": false}},
        {"emit": {"message": "actor.done", "fields": {}}}
      ],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.COMPLETE_API",
      "from": "HANDLING_API",
      "to": "IDLE",
      "event": "actor.complete",
      "guard": true,
      "actions": [
        {"set": {"var": "reply_pending", "value": false}},
        {"set": {"var": "core_locked", "value": false}},
        {"emit": {"message": "actor.reply_post", "fields": {}}}
      ],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.COMPLETE_TIMER",
      "from": "HANDLING_TIMER",
      "to": "IDLE",
      "event": "actor.complete",
      "guard": true,
      "actions": [
        {"set": {"var": "core_locked", "value": false}},
        {"emit": {"message": "actor.done", "fields": {}}}
      ],
      "requirements": ["TCPIP_ACTOR"]
    },
    {
      "id": "ACTOR.STOP",
      "from": "IDLE",
      "to": "STOPPED",
      "event": "actor.stop",
      "guard": {"op": "and", "args": [{"op": "eq", "args": [{"var": "pending_rx"}, 0]}, {"op": "eq", "args": [{"var": "pending_api"}, 0]}]},
      "actions": [
        {"set": {"var": "core_locked", "value": false}},
        {"set": {"var": "reply_pending", "value": false}},
        {"emit": {"message": "actor.stopped", "fields": {}}}
      ],
      "requirements": ["TCPIP_ACTOR"]
    }
  ]
}
