{
  "ir_version": "0.6",
  "semantics": "flat-efsm-atomic-ordered-v1",
  "protocol": "arch-sys-port",
  "scope": {
    "terminal_states": [],
    "excluded": [
      "host OS syscalls"
    ]
  },
  "states": [
    "UNINIT",
    "READY",
    "STOPPED"
  ],
  "initial_state": "UNINIT",
  "requirements": {
    "ARCH.PORT": {
      "source": "spec/arch/sys-port.md",
      "interpretation": "OS port abstraction"
    }
  },
  "variables": {
    "sem_live": {
      "type": "int",
      "initial": 0
    },
    "mbox_live": {
      "type": "int",
      "initial": 0
    },
    "threads_live": {
      "type": "int",
      "initial": 0
    }
  },
  "events": {
    "port.start": {
      "origin": "application",
      "fields": {}
    },
    "port.stop": {
      "origin": "application",
      "fields": {}
    },
    "port.sem_alloc": {
      "origin": "application",
      "fields": {}
    },
    "port.sem_free": {
      "origin": "application",
      "fields": {}
    },
    "port.mbox_alloc": {
      "origin": "application",
      "fields": {}
    },
    "port.mbox_free": {
      "origin": "application",
      "fields": {}
    },
    "port.thread_spawn": {
      "origin": "application",
      "fields": {}
    },
    "port.thread_join": {
      "origin": "application",
      "fields": {}
    }
  },
  "messages": {},
  "timers": {},
  "transitions": [
    {
      "id": "SP.START",
      "from": "UNINIT",
      "to": "READY",
      "event": "port.start",
      "guard": true,
      "actions": [],
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.RESTART",
      "from": "STOPPED",
      "to": "READY",
      "event": "port.start",
      "guard": true,
      "actions": [],
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.STOP",
      "from": "READY",
      "to": "STOPPED",
      "event": "port.stop",
      "guard": true,
      "actions": [],
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.SEM_ALLOC",
      "from": "READY",
      "to": "READY",
      "event": "port.sem_alloc",
      "guard": {
        "op": "not",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "sem_live"
              },
              256
            ]
          }
        ]
      },
      "actions": [
        {
          "set": {
            "var": "sem_live",
            "value": {
              "op": "add",
              "args": [
                {
                  "var": "sem_live"
                },
                1
              ]
            }
          }
        }
      ],
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.SEM_FREE",
      "from": "READY",
      "to": "READY",
      "event": "port.sem_free",
      "guard": {
        "op": "not",
        "args": [
          {
            "op": "le",
            "args": [
              {
                "var": "sem_live"
              },
              0
            ]
          }
        ]
      },
      "actions": [
        {
          "set": {
            "var": "sem_live",
            "value": {
              "op": "sub",
              "args": [
                {
                  "var": "sem_live"
                },
                1
              ]
            }
          }
        }
      ],
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.MBOX_ALLOC",
      "from": "READY",
      "to": "READY",
      "event": "port.mbox_alloc",
      "guard": {
        "op": "not",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "mbox_live"
              },
              256
            ]
          }
        ]
      },
      "actions": [
        {
          "set": {
            "var": "mbox_live",
            "value": {
              "op": "add",
              "args": [
                {
                  "var": "mbox_live"
                },
                1
              ]
            }
          }
        }
      ],
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.MBOX_FREE",
      "from": "READY",
      "to": "READY",
      "event": "port.mbox_free",
      "guard": {
        "op": "not",
        "args": [
          {
            "op": "le",
            "args": [
              {
                "var": "mbox_live"
              },
              0
            ]
          }
        ]
      },
      "actions": [
        {
          "set": {
            "var": "mbox_live",
            "value": {
              "op": "sub",
              "args": [
                {
                  "var": "mbox_live"
                },
                1
              ]
            }
          }
        }
      ],
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.THR_SPAWN",
      "from": "READY",
      "to": "READY",
      "event": "port.thread_spawn",
      "guard": {
        "op": "not",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "threads_live"
              },
              64
            ]
          }
        ]
      },
      "actions": [
        {
          "set": {
            "var": "threads_live",
            "value": {
              "op": "add",
              "args": [
                {
                  "var": "threads_live"
                },
                1
              ]
            }
          }
        }
      ],
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.THR_JOIN",
      "from": "READY",
      "to": "READY",
      "event": "port.thread_join",
      "guard": {
        "op": "not",
        "args": [
          {
            "op": "le",
            "args": [
              {
                "var": "threads_live"
              },
              0
            ]
          }
        ]
      },
      "actions": [
        {
          "set": {
            "var": "threads_live",
            "value": {
              "op": "sub",
              "args": [
                {
                  "var": "threads_live"
                },
                1
              ]
            }
          }
        }
      ],
      "requirements": [
        "ARCH.PORT"
      ]
    }
  ],
  "invariants": [
    {
      "id": "SP.SEM_BOUNDS",
      "assert": {
        "op": "and",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "sem_live"
              },
              0
            ]
          },
          {
            "op": "le",
            "args": [
              {
                "var": "sem_live"
              },
              256
            ]
          }
        ]
      },
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.MBOX_BOUNDS",
      "assert": {
        "op": "and",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "mbox_live"
              },
              0
            ]
          },
          {
            "op": "le",
            "args": [
              {
                "var": "mbox_live"
              },
              256
            ]
          }
        ]
      },
      "requirements": [
        "ARCH.PORT"
      ]
    },
    {
      "id": "SP.THR_BOUNDS",
      "assert": {
        "op": "and",
        "args": [
          {
            "op": "ge",
            "args": [
              {
                "var": "threads_live"
              },
              0
            ]
          },
          {
            "op": "le",
            "args": [
              {
                "var": "threads_live"
              },
              64
            ]
          }
        ]
      },
      "requirements": [
        "ARCH.PORT"
      ]
    }
  ]
}
