{
  "ir_version": "0.6",
  "semantics": "flat-efsm-atomic-ordered-v1",
  "protocol": "arch-pbuf-pool",
  "states": ["FREE", "OWNED", "SHARED", "QUEUED"],
  "initial_state": "FREE",
  "scope": {
    "terminal_states": [],
    "excluded": ["scatter-gather-chain-pointer-graph"]
  },
  "requirements": {
    "PBUF_POOL": {
      "source": "spec/arch/pbuf-pool.md#scope",
      "interpretation": "Single-instance pbuf refcount conservation, headroom bounds, and queue ownership."
    }
  },
  "variables": {
    "ref": {"type": "int", "initial": 0},
    "cap": {"type": "int", "initial": 0},
    "headroom": {"type": "int", "initial": 0},
    "len": {"type": "int", "initial": 0},
    "queued": {"type": "bool", "initial": false}
  },
  "events": {
    "pbuf.alloc": {"origin": "application", "fields": {"cap": "int", "headroom": "int", "len": "int"}},
    "pbuf.ref": {"origin": "application", "fields": {}},
    "pbuf.free": {"origin": "application", "fields": {}},
    "pbuf.header_push": {"origin": "application", "fields": {"bytes": "int"}},
    "pbuf.header_pop": {"origin": "application", "fields": {"bytes": "int"}},
    "pbuf.enqueue": {"origin": "application", "fields": {}},
    "pbuf.dequeue": {"origin": "application", "fields": {}}
  },
  "messages": {
    "pbuf.ok": {"fields": {"ref": "int", "headroom": "int", "len": "int"}},
    "pbuf.freed": {"fields": {}}
  },
  "timers": {},
  "invariants": [
    {
      "id": "PBUF_REF_CONSISTENCY",
      "assert": {
        "op": "or",
        "args": [
          {"op": "and", "args": [{"state": "FREE"}, {"op": "and", "args": [{"op": "eq", "args": [{"var": "ref"}, 0]}, {"op": "not", "args": [{"var": "queued"}]}]}]},
          {"op": "or", "args": [
            {"op": "and", "args": [{"state": "OWNED"}, {"op": "and", "args": [{"op": "eq", "args": [{"var": "ref"}, 1]}, {"op": "not", "args": [{"var": "queued"}]}]}]},
            {"op": "or", "args": [
              {"op": "and", "args": [{"state": "SHARED"}, {"op": "and", "args": [{"op": "ge", "args": [{"var": "ref"}, 2]}, {"op": "not", "args": [{"var": "queued"}]}]}]},
              {"op": "and", "args": [{"state": "QUEUED"}, {"op": "and", "args": [{"op": "ge", "args": [{"var": "ref"}, 1]}, {"var": "queued"}]}]}
            ]}
          ]}
        ]
      },
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF_SLICE_BOUNDS",
      "assert": {
        "op": "and",
        "args": [
          {"op": "le", "args": [0, {"var": "headroom"}]},
          {"op": "and", "args": [
            {"op": "le", "args": [0, {"var": "len"}]},
            {"op": "and", "args": [
              {"op": "le", "args": [{"op": "add", "args": [{"var": "headroom"}, {"var": "len"}]}, {"var": "cap"}]},
              {"op": "le", "args": [{"var": "cap"}, 2048]}
            ]}
          ]}
        ]
      },
      "requirements": ["PBUF_POOL"]
    }
  ],
  "transitions": [
    {
      "id": "PBUF.ALLOC",
      "from": "FREE",
      "to": "OWNED",
      "event": "pbuf.alloc",
      "guard": {
        "op": "and",
        "args": [
          {"op": "ge", "args": [{"event": "cap"}, 1]},
          {"op": "and", "args": [
            {"op": "le", "args": [{"event": "cap"}, 2048]},
            {"op": "and", "args": [
              {"op": "ge", "args": [{"event": "headroom"}, 0]},
              {"op": "and", "args": [
                {"op": "ge", "args": [{"event": "len"}, 0]},
                {"op": "le", "args": [{"op": "add", "args": [{"event": "headroom"}, {"event": "len"}]}, {"event": "cap"}]}
              ]}
            ]}
          ]}
        ]
      },
      "actions": [
        {"set": {"var": "ref", "value": 1}},
        {"set": {"var": "cap", "value": {"event": "cap"}}},
        {"set": {"var": "headroom", "value": {"event": "headroom"}}},
        {"set": {"var": "len", "value": {"event": "len"}}},
        {"set": {"var": "queued", "value": false}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": 1, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.REF_FROM_OWNED",
      "from": "OWNED",
      "to": "SHARED",
      "event": "pbuf.ref",
      "guard": true,
      "actions": [
        {"set": {"var": "ref", "value": 2}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": 2, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.REF_FROM_SHARED",
      "from": "SHARED",
      "to": "SHARED",
      "event": "pbuf.ref",
      "guard": {"op": "le", "args": [{"var": "ref"}, 1024]},
      "actions": [
        {"set": {"var": "ref", "value": {"op": "add", "args": [{"var": "ref"}, 1]}}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": {"var": "ref"}, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.REF_FROM_QUEUED",
      "from": "QUEUED",
      "to": "QUEUED",
      "event": "pbuf.ref",
      "guard": {"op": "le", "args": [{"var": "ref"}, 1024]},
      "actions": [
        {"set": {"var": "ref", "value": {"op": "add", "args": [{"var": "ref"}, 1]}}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": {"var": "ref"}, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.FREE_OWNED",
      "from": "OWNED",
      "to": "FREE",
      "event": "pbuf.free",
      "guard": true,
      "actions": [
        {"set": {"var": "ref", "value": 0}},
        {"set": {"var": "cap", "value": 0}},
        {"set": {"var": "headroom", "value": 0}},
        {"set": {"var": "len", "value": 0}},
        {"set": {"var": "queued", "value": false}},
        {"emit": {"message": "pbuf.freed", "fields": {}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.FREE_SHARED_LAST",
      "from": "SHARED",
      "to": "OWNED",
      "event": "pbuf.free",
      "guard": {"op": "eq", "args": [{"var": "ref"}, 2]},
      "actions": [
        {"set": {"var": "ref", "value": 1}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": 1, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.FREE_SHARED_MANY",
      "from": "SHARED",
      "to": "SHARED",
      "event": "pbuf.free",
      "guard": {"op": "ge", "args": [{"var": "ref"}, 3]},
      "actions": [
        {"set": {"var": "ref", "value": {"op": "sub", "args": [{"var": "ref"}, 1]}}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": {"var": "ref"}, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.HEADER_PUSH",
      "from": "OWNED",
      "to": "OWNED",
      "event": "pbuf.header_push",
      "guard": {"op": "and", "args": [{"op": "ge", "args": [{"event": "bytes"}, 0]}, {"op": "le", "args": [{"event": "bytes"}, {"var": "headroom"}]}]},
      "actions": [
        {"set": {"var": "headroom", "value": {"op": "sub", "args": [{"var": "headroom"}, {"event": "bytes"}]}}},
        {"set": {"var": "len", "value": {"op": "add", "args": [{"var": "len"}, {"event": "bytes"}]}}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": 1, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.HEADER_POP",
      "from": "OWNED",
      "to": "OWNED",
      "event": "pbuf.header_pop",
      "guard": {"op": "and", "args": [{"op": "ge", "args": [{"event": "bytes"}, 0]}, {"op": "le", "args": [{"event": "bytes"}, {"var": "len"}]}]},
      "actions": [
        {"set": {"var": "headroom", "value": {"op": "add", "args": [{"var": "headroom"}, {"event": "bytes"}]}}},
        {"set": {"var": "len", "value": {"op": "sub", "args": [{"var": "len"}, {"event": "bytes"}]}}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": 1, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.ENQUEUE_OWNED",
      "from": "OWNED",
      "to": "QUEUED",
      "event": "pbuf.enqueue",
      "guard": true,
      "actions": [
        {"set": {"var": "queued", "value": true}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": {"var": "ref"}, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.ENQUEUE_SHARED",
      "from": "SHARED",
      "to": "QUEUED",
      "event": "pbuf.enqueue",
      "guard": true,
      "actions": [
        {"set": {"var": "queued", "value": true}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": {"var": "ref"}, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.DEQUEUE_ONE",
      "from": "QUEUED",
      "to": "OWNED",
      "event": "pbuf.dequeue",
      "guard": {"op": "eq", "args": [{"var": "ref"}, 1]},
      "actions": [
        {"set": {"var": "queued", "value": false}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": 1, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    },
    {
      "id": "PBUF.DEQUEUE_SHARED",
      "from": "QUEUED",
      "to": "SHARED",
      "event": "pbuf.dequeue",
      "guard": {"op": "ge", "args": [{"var": "ref"}, 2]},
      "actions": [
        {"set": {"var": "queued", "value": false}},
        {"emit": {"message": "pbuf.ok", "fields": {"ref": {"var": "ref"}, "headroom": {"var": "headroom"}, "len": {"var": "len"}}}}
      ],
      "requirements": ["PBUF_POOL"]
    }
  ]
}
