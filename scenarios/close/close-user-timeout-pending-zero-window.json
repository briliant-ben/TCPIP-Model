{
  "scenario_version": "0.1",
  "id": "close-user-timeout-pending-zero-window",
  "description": "Finite close/data/FIN composition; independent final-state and timer expectations",
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect"
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 0
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          1,
          2
        ]
      }
    },
    {
      "at_ms": 30,
      "event": "app.close"
    },
    {
      "tick": true,
      "at_ms": 30030
    }
  ],
  "expect": {
    "state": "CLOSED",
    "timers": {},
    "variables": {
      "snd_buf": [],
      "rtx_buf": [],
      "fin_requested": false,
      "fin_sent": false
    }
  }
}
