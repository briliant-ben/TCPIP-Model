      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          1,
          2,
          3,
          4
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 30,
      "event": "net.data",
      "fields": {
        "seq": 9001,
        "ack": 1000,
        "window": 2,
        "data": [
          0,
          128
        ]
      }
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "snd_una": 1001,
      "snd_nxt": 1005,
      "rtx_buf": [
        1,
        2,
        3,
        4
      ],
      "snd_wnd": 8,
      "rcv_nxt": 9003,
      "rcv_buf": [
        0,
        128
      ]
    },
    "timers": {
