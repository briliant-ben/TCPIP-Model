{
  "scenario_version": "0.1",
  "id": "passive-ack-after-1-retries",
  "description": "passive ack after 1 retries",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Control-only validated IPv4/TCP packet shapes; no payload/options."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.listen",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.syn",
      "fields": {
        "seq": 9000
      }
    },
    {
      "at_ms": 1020,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1001
      }
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "retries": 1,
      "rto_ms": 3000
    },
    "timers": {}
  }
}
