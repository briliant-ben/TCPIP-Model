{
  "id": "s4-invalid-nonzero-checksum",
  "note": "nonzero invalid checksum silently discards; zero checksum is accepted regardless of sum_valid",
  "steps": [
    {
      "event": "net.datagram",
      "fields": {
        "source_port": 1111,
        "destination_port": 8080,
        "length": 9,
        "checksum": 4242,
        "sum_valid": false,
        "data": [
          65
        ]
      },
      "expect_trace": [
        {
          "at_ms": 0,
          "emitted": []
        }
      ],
      "at_ms": 0
    },
    {
      "event": "net.datagram",
      "fields": {
        "source_port": 1111,
        "destination_port": 8080,
        "length": 9,
        "checksum": 0,
        "sum_valid": false,
        "data": [
          65
        ]
      },
      "expect_trace": [
        {
          "at_ms": 0,
          "emitted": [
            {
              "message": "udp.delivery",
              "fields": {
                "source_port": 1111,
                "destination_port": 8080,
                "data": [
                  65
                ]
              }
            }
          ]
        }
      ],
      "at_ms": 0
    }
  ],
  "initial": {},
  "expect": {
    "state": "READY",
    "timers": {}
  },
  "scenario_version": "0.2"
}
