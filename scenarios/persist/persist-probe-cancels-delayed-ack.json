{
  "scenario_version": "0.2",
  "id": "persist-probe-cancels-delayed-ack",
  "description": "Independent hand-calculated one-octet persist/sequence/timing contract. Synthetic evidence only.",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Finite no-flight zero-window demand; valid abstract ACK/window events. No resource/user abort policy."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 0
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          128
        ]
      },
      "expect_trace": [
        {
          "at_ms": 20,
          "emitted": [
            {
              "message": "application",
              "fields": {
                "code": "queued"
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 1000,
      "event": "net.data",
      "fields": {
        "seq": 9001,
        "ack": 1001,
        "window": 0,
        "data": [
          9,
          8
        ]
      },
      "expect_trace": [
        {
          "at_ms": 1000,
          "emitted": []
        }
      ]
    },
    {
      "at_ms": 1020,
      "tick": true,
      "expect_trace": [
        {
          "at_ms": 1020,
          "emitted": [
            {
              "message": "tcp_data",
              "fields": {
                "flags": "A",
                "seq": 1001,
                "ack": 9003,
                "window": 14,
                "payload": [
                  0
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 1040,
      "tick": true,
      "expect_trace": []
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "snd_buf": [
        128
      ],
      "rtx_buf": [
        0
      ],
      "snd_una": 1001,
      "snd_nxt": 1002,
      "rto_ms": 1000,
      "retries": 0,
      "ack_pending": false,
      "rcv_nxt": 9003,
      "rcv_buf": [
        9,
        8
      ]
    },
    "timers": {
      "persist": 3020
    }
  }
}
