{
  "scenario_version": "0.2",
  "id": "pinned-active-open-contract",
  "description": "Independent fixed output/time contract for the declared 1s no-SYN-data profile; not generated from candidate IR.",
  "initial": {
    "iss": 1000
  },
  "environment": {
    "assumptions": [
      "RFC9293 August2022 \u00a7\u00a73.10.1/3.10.7.3 and RFC6298 June2011 \u00a75; configured initial RTO1000ms",
      "Peer response withheld until1010ms; no physical network claim",
      "ISS1000 and advertised window65535 are fixed fixture/profile choices, not universal RFC requirements"
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {},
      "expect_trace": [
        {
          "at_ms": 0,
          "emitted": [
            {
              "message": "tcp",
              "fields": {
                "flags": "S",
                "seq": 1000,
                "ack": 0,
                "window": 65535
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 1010,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001
      },
      "expect_trace": [
        {
          "at_ms": 1000,
          "emitted": [
            {
              "message": "tcp",
              "fields": {
                "flags": "S",
                "seq": 1000,
                "ack": 0,
                "window": 65535
              }
            }
          ]
        },
        {
          "at_ms": 1010,
          "emitted": [
            {
              "message": "tcp",
              "fields": {
                "flags": "A",
                "seq": 1001,
                "ack": 9001,
                "window": 65535
              }
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "retries": 1,
      "snd_nxt": 1001,
      "snd_una": 1001,
      "rcv_nxt": 9001
    },
    "timers": {}
  },
  "settle_ms": 6010
}
