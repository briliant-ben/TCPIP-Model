{
  "scenario_version": "0.2",
  "id": "schedule-window4-full",
  "description": "Same full external inputs plus four declared segment choices",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "MSS4/window16; MORE no PSH; <=200ms; explicit app.transmit scheduling"
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 4
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          128,
          255,
          7,
          17,
          33,
          65,
          129
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit",
      "fields": {},
      "expect_trace": [
        {
          "at_ms": 21,
          "emitted": []
        }
      ]
    },
    {
      "at_ms": 21,
      "event": "choice.segment",
      "fields": {
        "count": 2
      },
      "expect_trace": [
        {
          "at_ms": 21,
          "emitted": [
            {
              "message": "tcp_data",
              "fields": {
                "flags": "A",
                "seq": 1001,
                "ack": 9001,
                "window": 16,
                "payload": [
                  0,
                  128
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 21,
      "event": "choice.segment",
      "fields": {
        "count": 2
      },
      "expect_trace": [
        {
          "at_ms": 21,
          "emitted": [
            {
              "message": "tcp_data",
              "fields": {
                "flags": "A",
                "seq": 1003,
                "ack": 9001,
                "window": 16,
                "payload": [
                  255,
                  7
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 30,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1005,
        "window": 4
      }
    },
    {
      "at_ms": 30,
      "event": "choice.segment",
      "fields": {
        "count": 2
      },
      "expect_trace": [
        {
          "at_ms": 30,
          "emitted": [
            {
              "message": "tcp_data",
              "fields": {
                "flags": "A",
                "seq": 1005,
                "ack": 9001,
                "window": 16,
                "payload": [
                  17,
                  33
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 30,
      "event": "choice.segment",
      "fields": {
        "count": 2
      },
      "expect_trace": [
        {
          "at_ms": 30,
          "emitted": [
            {
              "message": "tcp_data",
              "fields": {
                "flags": "A",
                "seq": 1007,
                "ack": 9001,
                "window": 16,
                "payload": [
                  65,
                  129
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 30,
      "event": "app.transmit",
      "fields": {},
      "expect_trace": [
        {
          "at_ms": 30,
          "emitted": []
        }
      ]
    },
    {
      "at_ms": 40,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1009,
        "window": 4
