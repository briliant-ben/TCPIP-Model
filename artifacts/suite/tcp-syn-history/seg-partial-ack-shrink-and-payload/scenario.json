{
  "scenario_version": "0.1",
  "id": "seg-partial-ack-shrink-and-payload",
  "description": "seg partial ack shrink and payload",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Finite ACK+payload/window profile; validated ACK flag and payload shape, first accepted receive byte wins; raw accepted SEG.SEQ drives WL1."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          1,
          128,
          255,
          4,
          5
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 22,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 30,
      "event": "net.data",
      "fields": {
        "seq": 9001,
        "ack": 1003,
        "window": 1,
        "data": [
          7,
          8
        ]
      }
    },
    {
      "at_ms": 1030,
      "tick": true
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "snd_una": 1003,
      "snd_nxt": 1007,
      "rtx_buf": [
        128,
        255,
        4,
        5
      ],
      "snd_wnd": 1,
      "rcv_nxt": 9003,
      "rcv_buf": [
        7,
        8
      ],
      "rto_ms": 2000
    },
    "timers": {
      "rtx": 3030
    }
  }
}
