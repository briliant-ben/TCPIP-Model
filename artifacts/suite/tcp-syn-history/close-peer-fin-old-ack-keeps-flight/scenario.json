{
  "scenario_version": "0.1",
  "id": "close-peer-fin-old-ack-keeps-flight",
  "description": "Finite close/data/FIN composition; independent final-state and timer expectations",
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect"
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          1,
          128,
          255,
          4,
          5
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit"
    },
    {
      "at_ms": 22,
      "event": "app.transmit"
    },
    {
      "at_ms": 25,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1003,
        "window": 8
      }
    },
    {
      "at_ms": 30,
      "event": "net.fin",
      "fields": {
        "seq": 9001,
        "ack": 1001
      }
    }
  ],
  "expect": {
    "state": "CLOSE-WAIT",
    "timers": {
      "rtx": 1025
    },
    "variables": {
      "snd_una": 1003,
      "rtx_buf": [
        128,
        255,
        4,
        5
      ],
      "rcv_nxt": 9002
    }
  }
}
