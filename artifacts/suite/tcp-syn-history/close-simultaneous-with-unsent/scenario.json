{
  "scenario_version": "0.1",
  "id": "close-simultaneous-with-unsent",
  "description": "Finite close/data/FIN composition; independent final-state and timer expectations",
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect"
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          1,
          128,
          255,
          4,
          5
        ]
      }
    },
    {
      "at_ms": 30,
      "event": "app.close"
    },
    {
      "at_ms": 35,
      "event": "app.send",
      "fields": {
        "data": [
          99
        ]
      }
    },
    {
      "at_ms": 40,
      "event": "app.transmit"
    },
    {
      "at_ms": 41,
      "event": "app.transmit"
    },
    {
      "at_ms": 42,
      "event": "app.transmit"
    },
    {
      "at_ms": 43,
      "event": "net.fin",
      "fields": {
        "seq": 9001,
        "ack": 1004
      }
    },
    {
      "at_ms": 44,
      "event": "net.ack",
      "fields": {
        "seq": 9002,
        "ack": 1008,
        "window": 8
      }
    }
  ],
  "expect": {
    "state": "TIME-WAIT",
    "timers": {
      "time_wait": 120044
    },
    "variables": {
      "snd_nxt": 1008,
      "snd_una": 1008,
      "rcv_nxt": 9002
    }
  }
}
