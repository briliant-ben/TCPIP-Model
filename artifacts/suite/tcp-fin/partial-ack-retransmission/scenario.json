{
  "scenario_version": "0.1",
  "id": "partial-ack-retransmission",
  "description": "partial ack retransmission",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Finite tcp-data profile; validated connection/packet/checksum; no advancing ACK or window update in payload events."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          128,
          255,
          4,
          5,
          6
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 22,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 30,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1003,
        "window": 8
      }
    },
    {
      "at_ms": 1030,
      "tick": true
    },
    {
      "at_ms": 1040,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1007,
        "window": 8
      }
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "snd_nxt": 1007,
      "snd_una": 1007,
      "rtx_buf": [],
      "rto_ms": 2000,
      "retries": 1
    },
    "timers": {}
  }
}
