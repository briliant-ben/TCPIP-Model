{
  "scenario_version": "0.1",
  "id": "close-queued-send-before-fin",
  "description": "Finite close/data/FIN composition; independent final-state and timer expectations",
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect"
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          1,
          128,
          255,
          4,
          5
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit"
    },
    {
      "at_ms": 30,
      "event": "app.close"
    },
    {
      "at_ms": 40,
      "event": "app.transmit"
    },
    {
      "at_ms": 41,
      "event": "app.transmit"
    },
    {
      "at_ms": 50,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1008,
        "window": 8
      }
    },
    {
      "at_ms": 60,
      "event": "net.fin",
      "fields": {
        "seq": 9001,
        "ack": 1008
      }
    }
  ],
  "expect": {
    "state": "TIME-WAIT",
    "timers": {
      "time_wait": 120060
    },
    "variables": {
      "snd_una": 1008,
      "snd_buf": [],
      "rtx_buf": []
    }
  }
}
