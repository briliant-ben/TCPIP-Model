{
  "scenario_version": "0.1",
  "id": "duplicate-old-future-ack",
  "description": "duplicate old future ack",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Finite tcp-data profile; validated connection/packet/checksum; no advancing ACK or window update in payload events."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          1,
          2,
          3,
          4
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 30,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 31,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1000,
        "window": 8
      }
    },
    {
      "at_ms": 32,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1006,
        "window": 8
      }
    },
    {
      "at_ms": 40,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1005,
        "window": 8
      }
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "snd_nxt": 1005,
      "snd_una": 1005,
      "rtx_buf": []
    },
    "timers": {}
  }
}
