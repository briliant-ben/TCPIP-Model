digraph protocol {
  rankdir=LR;
  "CLOSED";
  "LISTEN";
  "SYN-SENT";
  "SYN-RECEIVED";
  "ESTABLISHED";
  "FIN-WAIT-1";
  "FIN-WAIT-2";
  "CLOSE-WAIT";
  "CLOSING";
  "LAST-ACK";
  "TIME-WAIT";
  "CLOSED" -> "SYN-SENT" [label="C-ACTIVE-OPEN\napp.connect"];
  "CLOSED" -> "LISTEN" [label="C-PASSIVE-OPEN\napp.listen"];
  "LISTEN" -> "SYN-RECEIVED" [label="C-LISTEN-SYN\nnet.syn"];
  "SYN-SENT" -> "SYN-RECEIVED" [label="C-SIMULTANEOUS-SYN\nnet.syn"];
  "SYN-SENT" -> "ESTABLISHED" [label="C-ACCEPT-SYNACK\nnet.synack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"var\":\"retries\"},0]}]}"];
  "SYN-RECEIVED" -> "ESTABLISHED" [label="C-ACCEPT-ACK\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]},{\"op\":\"eq\",\"args\":[{\"var\":\"retries\"},0]}]}"];
  "SYN-RECEIVED" -> "ESTABLISHED" [label="C-SIMULTANEOUS-SYNACK\nnet.synack\n{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"irs\"}]}]},{\"op\":\"eq\",\"args\":[{\"var\":\"retries\"},0]}]}"];
  "SYN-SENT" -> "ESTABLISHED" [label="C-ACCEPT-SYNACK-AFTER-RETRY\nnet.synack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"var\":\"retries\"},1]}]}"];
  "SYN-RECEIVED" -> "ESTABLISHED" [label="C-ACCEPT-ACK-AFTER-RETRY\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]},{\"op\":\"eq\",\"args\":[{\"var\":\"retries\"},1]}]}"];
  "SYN-RECEIVED" -> "ESTABLISHED" [label="C-SIMULTANEOUS-SYNACK-AFTER-RETRY\nnet.synack\n{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"irs\"}]}]},{\"op\":\"eq\",\"args\":[{\"var\":\"retries\"},1]}]}"];
  "SYN-SENT" -> "ESTABLISHED" [label="C-ACCEPT-SYNACK-AFTER-MULTIPLE-RETRIES\nnet.synack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"ge\",\"args\":[{\"var\":\"retries\"},2]}]}"];
  "SYN-RECEIVED" -> "ESTABLISHED" [label="C-ACCEPT-ACK-AFTER-MULTIPLE-RETRIES\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]},{\"op\":\"ge\",\"args\":[{\"var\":\"retries\"},2]}]}"];
  "SYN-RECEIVED" -> "ESTABLISHED" [label="C-SIMULTANEOUS-SYNACK-AFTER-MULTIPLE-RETRIES\nnet.synack\n{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"irs\"}]}]},{\"op\":\"ge\",\"args\":[{\"var\":\"retries\"},2]}]}"];
  "SYN-SENT" -> "SYN-SENT" [label="C-SYN-SENT-BAD-ACK\nnet.ack\n{\"op\":\"ne\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]}"];
  "SYN-SENT" -> "SYN-SENT" [label="C-SYN-SENT-BAD-SYNACK\nnet.synack\n{\"op\":\"ne\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]}"];
  "SYN-SENT" -> "SYN-SENT" [label="C-SYN-SENT-BARE-ACK\nnet.ack\n{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]}"];
  "SYN-RECEIVED" -> "SYN-RECEIVED" [label="C-SYN-RECEIVED-BAD-ACK\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"ne\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]}]}"];
  "ESTABLISHED" -> "FIN-WAIT-1" [label="C-CLOSE-ESTABLISHED\napp.close"];
  "CLOSE-WAIT" -> "LAST-ACK" [label="C-CLOSE-CLOSE-WAIT\napp.close"];
  "LISTEN" -> "CLOSED" [label="C-CLOSE-LISTEN\napp.close"];
  "SYN-SENT" -> "CLOSED" [label="C-CLOSE-SYN-SENT\napp.close"];
  "FIN-WAIT-1" -> "FIN-WAIT-1" [label="C-REPEATED-CLOSE-FIN-WAIT-1\napp.close"];
  "FIN-WAIT-2" -> "FIN-WAIT-2" [label="C-REPEATED-CLOSE-FIN-WAIT-2\napp.close"];
  "CLOSING" -> "CLOSING" [label="C-REPEATED-CLOSE-CLOSING\napp.close"];
  "LAST-ACK" -> "LAST-ACK" [label="C-REPEATED-CLOSE-LAST-ACK\napp.close"];
  "TIME-WAIT" -> "TIME-WAIT" [label="C-REPEATED-CLOSE-TIME-WAIT\napp.close"];
  "ESTABLISHED" -> "ESTABLISHED" [label="C-DUPLICATE-ACK-ESTABLISHED\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]}"];
  "CLOSE-WAIT" -> "CLOSE-WAIT" [label="C-DUPLICATE-ACK-CLOSE-WAIT\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]}"];
  "FIN-WAIT-2" -> "FIN-WAIT-2" [label="C-DUPLICATE-ACK-FIN-WAIT-2\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]}"];
  "FIN-WAIT-1" -> "FIN-WAIT-2" [label="C-FIN-ACK-FIN-WAIT-1\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]}"];
  "FIN-WAIT-1" -> "FIN-WAIT-1" [label="C-OLD-ACK-FIN-WAIT-1\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_una\"}]}]}"];
  "CLOSING" -> "TIME-WAIT" [label="C-FIN-ACK-CLOSING\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]}"];
  "CLOSING" -> "CLOSING" [label="C-OLD-ACK-CLOSING\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_una\"}]}]}"];
  "LAST-ACK" -> "CLOSED" [label="C-FIN-ACK-LAST-ACK\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]}"];
  "LAST-ACK" -> "LAST-ACK" [label="C-OLD-ACK-LAST-ACK\nnet.ack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_una\"}]}]}"];
  "ESTABLISHED" -> "CLOSE-WAIT" [label="C-PEER-FIN\nnet.fin\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]}"];
  "FIN-WAIT-2" -> "TIME-WAIT" [label="C-PEER-FIN-FW2\nnet.fin\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]}"];
  "FIN-WAIT-1" -> "TIME-WAIT" [label="C-PEER-FIN-FW1-ACKED\nnet.fin\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}]}"];
  "FIN-WAIT-1" -> "CLOSING" [label="C-SIMULTANEOUS-FIN\nnet.fin\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_una\"}]}]}"];
  "CLOSE-WAIT" -> "CLOSE-WAIT" [label="C-DUPLICATE-FIN-CLOSE-WAIT\nnet.fin\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"op\":\"seq_add\",\"args\":[{\"event\":\"seq\"},1]},{\"var\":\"rcv_nxt\"}]},{\"op\":\"or\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_una\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]}]}]}"];
  "CLOSING" -> "CLOSING" [label="C-DUPLICATE-FIN-CLOSING\nnet.fin\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"op\":\"seq_add\",\"args\":[{\"event\":\"seq\"},1]},{\"var\":\"rcv_nxt\"}]},{\"op\":\"or\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_una\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]}]}]}"];
  "LAST-ACK" -> "LAST-ACK" [label="C-DUPLICATE-FIN-LAST-ACK\nnet.fin\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"op\":\"seq_add\",\"args\":[{\"event\":\"seq\"},1]},{\"var\":\"rcv_nxt\"}]},{\"op\":\"or\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_una\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]}]}]}"];
  "TIME-WAIT" -> "TIME-WAIT" [label="C-DUPLICATE-FIN-TIME-WAIT\nnet.fin\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"op\":\"seq_add\",\"args\":[{\"event\":\"seq\"},1]},{\"var\":\"rcv_nxt\"}]},{\"op\":\"or\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_una\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]}]}]}"];
  "SYN-SENT" -> "SYN-SENT" [label="C-RETRANSMIT-SYN-SENT\ntimer.rtx"];
  "SYN-RECEIVED" -> "SYN-RECEIVED" [label="C-RETRANSMIT-SYN-RECEIVED\ntimer.rtx"];
  "FIN-WAIT-1" -> "FIN-WAIT-1" [label="C-RETRANSMIT-FIN-WAIT-1\ntimer.rtx"];
  "CLOSING" -> "CLOSING" [label="C-RETRANSMIT-CLOSING\ntimer.rtx"];
  "LAST-ACK" -> "LAST-ACK" [label="C-RETRANSMIT-LAST-ACK\ntimer.rtx"];
  "SYN-SENT" -> "CLOSED" [label="C-USER-TIMEOUT-SYN-SENT\ntimer.user"];
  "SYN-RECEIVED" -> "CLOSED" [label="C-USER-TIMEOUT-SYN-RECEIVED\ntimer.user"];
  "FIN-WAIT-1" -> "CLOSED" [label="C-USER-TIMEOUT-FIN-WAIT-1\ntimer.user"];
  "FIN-WAIT-2" -> "CLOSED" [label="C-USER-TIMEOUT-FIN-WAIT-2\ntimer.user"];
  "CLOSING" -> "CLOSED" [label="C-USER-TIMEOUT-CLOSING\ntimer.user"];
  "LAST-ACK" -> "CLOSED" [label="C-USER-TIMEOUT-LAST-ACK\ntimer.user"];
  "TIME-WAIT" -> "CLOSED" [label="C-TIME-WAIT-EXPIRED\ntimer.time_wait"];
  "CLOSED" -> "CLOSED" [label="C-ABORT-CLOSED\napp.abort"];
  "LISTEN" -> "CLOSED" [label="C-ABORT-LISTEN\napp.abort"];
  "SYN-SENT" -> "CLOSED" [label="C-ABORT-SYN-SENT\napp.abort"];
  "SYN-RECEIVED" -> "CLOSED" [label="C-ABORT-SYN-RECEIVED\napp.abort"];
  "ESTABLISHED" -> "CLOSED" [label="C-ABORT-ESTABLISHED\napp.abort"];
  "FIN-WAIT-1" -> "CLOSED" [label="C-ABORT-FIN-WAIT-1\napp.abort"];
  "FIN-WAIT-2" -> "CLOSED" [label="C-ABORT-FIN-WAIT-2\napp.abort"];
  "CLOSE-WAIT" -> "CLOSED" [label="C-ABORT-CLOSE-WAIT\napp.abort"];
  "CLOSING" -> "CLOSED" [label="C-ABORT-CLOSING\napp.abort"];
  "LAST-ACK" -> "CLOSED" [label="C-ABORT-LAST-ACK\napp.abort"];
  "TIME-WAIT" -> "CLOSED" [label="C-ABORT-TIME-WAIT\napp.abort"];
  "CLOSED" -> "CLOSED" [label="C-IGNORE-NET-RST-CLOSED\nnet.rst"];
  "LISTEN" -> "LISTEN" [label="C-IGNORE-NET-RST-LISTEN\nnet.rst"];
  "SYN-SENT" -> "SYN-SENT" [label="C-SYN-SENT-NET-RST\nnet.rst"];
  "SYN-RECEIVED" -> "LISTEN" [label="C-SYN-RECEIVED-NET-RST-PASSIVE\nnet.rst\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"var\":\"active_open\"},false]}]}"];
  "SYN-RECEIVED" -> "CLOSED" [label="C-SYN-RECEIVED-NET-RST-ACTIVE\nnet.rst\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"var\":\"active_open\"},true]}]}"];
  "ESTABLISHED" -> "CLOSED" [label="C-RESET-ESTABLISHED-rst\nnet.rst\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "FIN-WAIT-1" -> "CLOSED" [label="C-RESET-FIN-WAIT-1-rst\nnet.rst\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "FIN-WAIT-2" -> "CLOSED" [label="C-RESET-FIN-WAIT-2-rst\nnet.rst\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "CLOSE-WAIT" -> "CLOSED" [label="C-RESET-CLOSE-WAIT-rst\nnet.rst\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "CLOSING" -> "CLOSED" [label="C-RESET-CLOSING-rst\nnet.rst\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "LAST-ACK" -> "CLOSED" [label="C-RESET-LAST-ACK-rst\nnet.rst\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "TIME-WAIT" -> "CLOSED" [label="C-RESET-TIME-WAIT-rst\nnet.rst\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "CLOSED" -> "CLOSED" [label="C-IGNORE-NET-RSTACK-CLOSED\nnet.rstack"];
  "LISTEN" -> "LISTEN" [label="C-IGNORE-NET-RSTACK-LISTEN\nnet.rstack"];
  "SYN-SENT" -> "CLOSED" [label="C-SYN-SENT-NET-RSTACK\nnet.rstack\n{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]}"];
  "SYN-RECEIVED" -> "LISTEN" [label="C-SYN-RECEIVED-NET-RSTACK-PASSIVE\nnet.rstack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"var\":\"active_open\"},false]}]}"];
  "SYN-RECEIVED" -> "CLOSED" [label="C-SYN-RECEIVED-NET-RSTACK-ACTIVE\nnet.rstack\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"var\":\"active_open\"},true]}]}"];
  "ESTABLISHED" -> "CLOSED" [label="C-RESET-ESTABLISHED-rstack\nnet.rstack\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "FIN-WAIT-1" -> "CLOSED" [label="C-RESET-FIN-WAIT-1-rstack\nnet.rstack\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "FIN-WAIT-2" -> "CLOSED" [label="C-RESET-FIN-WAIT-2-rstack\nnet.rstack\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "CLOSE-WAIT" -> "CLOSED" [label="C-RESET-CLOSE-WAIT-rstack\nnet.rstack\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "CLOSING" -> "CLOSED" [label="C-RESET-CLOSING-rstack\nnet.rstack\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "LAST-ACK" -> "CLOSED" [label="C-RESET-LAST-ACK-rstack\nnet.rstack\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "TIME-WAIT" -> "CLOSED" [label="C-RESET-TIME-WAIT-rstack\nnet.rstack\n{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]}"];
  "CLOSED" -> "CLOSED" [label="C-REJECT-ACK-CLOSED\nnet.ack"];
  "LISTEN" -> "LISTEN" [label="C-REJECT-ACK-LISTEN\nnet.ack"];
  "CLOSED" -> "CLOSED" [label="C-REJECT-SYNACK-CLOSED\nnet.synack"];
  "LISTEN" -> "LISTEN" [label="C-REJECT-SYNACK-LISTEN\nnet.synack"];
  "CLOSED" -> "CLOSED" [label="C-REJECT-FIN-CLOSED\nnet.fin"];
  "LISTEN" -> "LISTEN" [label="C-REJECT-FIN-LISTEN\nnet.fin"];
  "CLOSED" -> "CLOSED" [label="C-CLOSED-SYN\nnet.syn"];
}
