{
  "scenario_version": "0.1",
  "id": "old-ack-from-closing",
  "description": "old ack from closing",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Control-only validated IPv4/TCP packet shapes; no payload/options."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001
      }
    },
    {
      "at_ms": 20,
      "event": "app.close",
      "fields": {}
    },
    {
      "at_ms": 30,
      "event": "net.fin",
      "fields": {
        "seq": 9001,
        "ack": 1001
      }
    },
    {
      "at_ms": 50,
      "event": "net.ack",
      "fields": {
        "seq": 9002,
        "ack": 1001
      }
    }
  ],
  "expect": {
    "state": "CLOSING",
    "variables": {},
    "timers": {
      "rtx": 1020,
      "user": 30020
    }
  }
}
