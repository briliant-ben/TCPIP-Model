{
  "scenario_version": "0.1",
  "id": "close-active-with-reassembly-gap",
  "description": "Finite close/data/FIN composition; independent final-state and timer expectations",
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect"
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 15,
      "event": "net.data",
      "fields": {
        "seq": 9003,
        "ack": 1001,
        "window": 8,
        "data": [
          128,
          255
        ]
      }
    },
    {
      "at_ms": 20,
      "event": "app.close"
    },
    {
      "at_ms": 30,
      "event": "net.data",
      "fields": {
        "seq": 9001,
        "ack": 1001,
        "window": 8,
        "data": [
          0,
          1
        ]
      }
    },
    {
      "at_ms": 40,
      "event": "net.ack",
      "fields": {
        "seq": 9005,
        "ack": 1002,
        "window": 8
      }
    },
    {
      "at_ms": 50,
      "event": "net.fin",
      "fields": {
        "seq": 9005,
        "ack": 1002
      }
    },
    {
      "at_ms": 60,
      "event": "app.receive",
      "fields": {
        "count": 4
      }
    }
  ],
  "expect": {
    "state": "TIME-WAIT",
    "timers": {
      "time_wait": 120050
    },
    "variables": {
      "snd_nxt": 1002,
      "rcv_nxt": 9006,
      "rcv_buf": [],
      "rx_slot_00": [],
      "rx_slot_02": []
    }
  }
}
