{
  "scenario_version": "0.1",
  "id": "drain-before-active-close",
  "description": "drain before active close",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Finite tcp-data profile; validated connection/packet/checksum; no advancing ACK or window update in payload events."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          1,
          2
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 30,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1003,
        "window": 8
      }
    },
    {
      "at_ms": 40,
      "event": "app.close",
      "fields": {}
    },
    {
      "at_ms": 50,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1004,
        "window": 8
      }
    },
    {
      "at_ms": 60,
      "event": "net.fin",
      "fields": {
        "seq": 9001,
        "ack": 1004
      }
    },
    {
      "at_ms": 120060,
      "tick": true
    }
  ],
  "expect": {
    "state": "CLOSED",
    "variables": {
      "snd_nxt": 1004,
      "rtx_buf": []
    },
    "timers": {}
  }
}
