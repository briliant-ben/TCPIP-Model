{
  "scenario_version": "0.1",
  "id": "zero-window-reopen",
  "description": "zero window reopen",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Finite tcp-data profile; validated connection/packet/checksum; no advancing ACK or window update in payload events."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 0
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          1,
          2
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 30,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1001,
        "window": 2
      }
    },
    {
      "at_ms": 31,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 40,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1003,
        "window": 0
      }
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "snd_nxt": 1003,
      "snd_una": 1003,
      "rtx_buf": [],
      "snd_wnd": 0
    },
    "timers": {}
  }
}
