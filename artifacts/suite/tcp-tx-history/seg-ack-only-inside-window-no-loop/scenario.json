{
  "scenario_version": "0.1",
  "id": "seg-ack-only-inside-window-no-loop",
  "description": "seg ack only inside window no loop",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Finite ACK+payload/window profile; validated ACK flag and payload shape, first accepted receive byte wins; raw accepted SEG.SEQ drives WL1."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          1,
          2,
          3,
          4
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 30,
      "event": "net.ack",
      "fields": {
        "seq": 9016,
        "ack": 1003,
        "window": 8
      }
    },
    {
      "at_ms": 40,
      "event": "net.ack",
      "fields": {
        "seq": 9016,
        "ack": 1005,
        "window": 8
      }
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "snd_una": 1005,
      "rtx_buf": [],
      "snd_wnd": 8,
      "snd_wl1": 9016,
      "snd_wl2": 1005,
      "rcv_nxt": 9001,
      "rcv_buf": []
    },
    "timers": {}
  }
}
