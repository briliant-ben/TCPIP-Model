{
  "scenario_version": "0.1",
  "id": "close-payload-acks-fin-before-text",
  "description": "Finite close/data/FIN composition; independent final-state and timer expectations",
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect"
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 8
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          1,
          2,
          3,
          4
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.transmit"
    },
    {
      "at_ms": 25,
      "event": "app.close"
    },
    {
      "at_ms": 30,
      "event": "net.data",
      "fields": {
        "seq": 9001,
        "ack": 1006,
        "window": 8,
        "data": [
          7,
          8
        ]
      }
    }
  ],
  "expect": {
    "state": "FIN-WAIT-2",
    "timers": {
      "user": 30025
    },
    "variables": {
      "snd_una": 1006,
      "rcv_nxt": 9003,
      "rcv_buf": [
        7,
        8
      ],
      "fin_sent": false
    }
  }
}
