{
  "scenario_version": "0.2",
  "id": "lt-one-byte-window",
  "description": "lt-one-byte-window",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "SMSS4/queue16; pure scripted non-SACK duplicates; default IW4; no independent loss claim"
