    {
      "at_ms": 32,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1001,
        "window": 5
      },
      "expect_trace": [
        {
          "at_ms": 32,
          "emitted": [
            {
              "message": "tcp_data",
              "fields": {
                "flags": "A",
                "seq": 1001,
                "ack": 9001,
                "window": 16,
