  "SYN-RECEIVED" -> "CLOSED" [label="C-SYN-RECEIVED-NET-RST-ACTIVE\nnet.rst\n{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"rcv_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"var\":\"active_open\"},true]}]}"];
