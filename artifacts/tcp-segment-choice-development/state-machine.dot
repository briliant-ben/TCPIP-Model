  "SYN-RECEIVED" -> "ESTABLISHED" [label="C-SIMULTANEOUS-SYNACK-AFTER-MULTIPLE-RETRIES\nnet.synack\n{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"eq\",\"args\":[{\"event\":\"ack\"},{\"var\":\"snd_nxt\"}]},{\"op\":\"eq\",\"args\":[{\"event\":\"seq\"},{\"var\":\"irs\"}]}]},{\"op\":\"ge\",\"args\":[{\"var\":\"retries\"},2]}]},{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[true,{\"op\":\"ge\",\"args\":[{\"event\":\"window\"},0]}]},{\"op\":\"le\",\"args\":[{\"event\":\"window\"},65535]}]}]}"];
