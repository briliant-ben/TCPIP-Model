  "ESTABLISHED" -> "ESTABLISHED" [label="D-FLUSH-FIRST\napp.transmit\n{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[true,{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[true,{\"op\":\"ge\",\"args\":[{\"op\":\"bytes_len\",\"args\":[{\"var\":\"snd_buf\"}]},1]}]},{\"op\":\"ge\",\"args\":[{\"op\":\"sub\",\"args\":[{\"var\":\"snd_wnd\"},{\"op\":\"bytes_len\",\"args\":[{\"var\":\"rtx_buf\"}]}]},1]}]}]},{\"op\":\"eq\",\"args\":[{\"op\":\"bytes_len\",\"args\":[{\"var\":\"rtx_buf\"}]},0]}]},{\"op\":\"ge\",\"args\":[{\"op\":\"sub\",\"args\":[{\"op\":\"ite\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[true,{\"var\":\"idle_data_valid\"}]},{\"op\":\"not\",\"args\":[{\"var\":\"fin_sent\"}]}]},{\"op\":\"ge\",\"args\":[{\"op\":\"bytes_len\",\"args\":[{\"var\":\"snd_buf\"}]},1]}]},{\"op\":\"not\",\"args\":[{\"op\":\"ge\",\"args\":[{\"var\":\"rto_ms\"},{\"op\":\"sub\",\"args\":[{\"clock_ms\":true},{\"var\":\"idle_last_data_ms\"}]}]}]}]},{\"op\":\"min\",\"args\":[{\"var\":\"cc_initial_window\"},{\"var\":\"cc_cwnd\"}]},{\"var\":\"cc_cwnd\"}]},{\"op\":\"bytes_len\",\"args\":[{\"var\":\"rtx_buf\"}]}]},1]}]}"];
  "ESTABLISHED" -> "ESTABLISHED" [label="D-FLUSH-MORE\napp.transmit\n{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[true,{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[true,{\"op\":\"ge\",\"args\":[{\"op\":\"bytes_len\",\"args\":[{\"var\":\"snd_buf\"}]},1]}]},{\"op\":\"ge\",\"args\":[{\"op\":\"sub\",\"args\":[{\"var\":\"snd_wnd\"},{\"op\":\"bytes_len\",\"args\":[{\"var\":\"rtx_buf\"}]}]},1]}]}]},{\"op\":\"ge\",\"args\":[{\"op\":\"bytes_len\",\"args\":[{\"var\":\"rtx_buf\"}]},1]}]},{\"op\":\"ge\",\"args\":[{\"op\":\"sub\",\"args\":[{\"op\":\"ite\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[{\"op\":\"and\",\"args\":[true,{\"var\":\"idle_data_valid\"}]},{\"op\":\"not\",\"args\":[{\"var\":\"fin_sent\"}]}]},{\"op\":\"ge\",\"args\":[{\"op\":\"bytes_len\",\"args\":[{\"var\":\"snd_buf\"}]},1]}]},{\"op\":\"not\",\"args\":[{\"op\":\"ge\",\"args\":[{\"var\":\"rto_ms\"},{\"op\":\"sub\",\"args\":[{\"clock_ms\":true},{\"var\":\"idle_last_data_ms\"}]}]}]}]},{\"op\":\"min\",\"args\":[{\"var\":\"cc_initial_window\"},{\"var\":\"cc_cwnd\"}]},{\"var\":\"cc_cwnd\"}]},{\"op\":\"bytes_len\",\"args\":[{\"var\":\"rtx_buf\"}]}]},1]}]}"];
