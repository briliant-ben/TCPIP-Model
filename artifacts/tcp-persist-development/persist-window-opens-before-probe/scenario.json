{
  "scenario_version": "0.2",
  "id": "persist-window-opens-before-probe",
  "description": "Independent hand-calculated one-octet persist/sequence/timing contract. Synthetic evidence only.",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "Finite no-flight zero-window demand; valid abstract ACK/window events. No resource/user abort policy."
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 0
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          128
        ]
      },
      "expect_trace": [
        {
          "at_ms": 20,
          "emitted": [
            {
              "message": "application",
              "fields": {
                "code": "queued"
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 100,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1001,
        "window": 2
      },
      "expect_trace": [
        {
          "at_ms": 100,
          "emitted": []
        }
      ]
    },
    {
      "at_ms": 101,
      "event": "app.transmit",
      "fields": {},
      "expect_trace": [
        {
          "at_ms": 101,
          "emitted": [
            {
              "message": "tcp_data",
              "fields": {
                "flags": "A",
                "seq": 1001,
                "ack": 9001,
                "window": 16,
                "payload": [
                  0,
                  128
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 1020,
      "tick": true,
      "expect_trace": []
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "snd_buf": [],
      "rtx_buf": [
        0,
        128
      ],
      "snd_una": 1001,
      "snd_nxt": 1003,
      "rto_ms": 1000,
      "retries": 0,
      "persist_active": false,
      "persist_probes": 0
    },
    "timers": {
      "rtx": 1101
    }
  }
}
