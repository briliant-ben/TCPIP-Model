{
  "scenario_version": "0.2",
  "id": "push-prefix-later-write",
  "description": "Independent handwritten byte/order/time contract for sender SWS composition",
  "initial": {},
  "environment": {
    "drop_outgoing": [],
    "assumptions": [
      "finite IR reference/SMT/synthetic codec only; not an independent C or Linux execution"
    ]
  },
  "steps": [
    {
      "at_ms": 0,
      "event": "app.connect",
      "fields": {}
    },
    {
      "at_ms": 10,
      "event": "net.synack",
      "fields": {
        "seq": 9000,
        "ack": 1001,
        "window": 16
      }
    },
    {
      "at_ms": 20,
      "event": "app.send",
      "fields": {
        "data": [
          0,
          128
        ]
      }
    },
    {
      "at_ms": 21,
      "event": "app.push",
      "fields": {}
    },
    {
      "at_ms": 22,
      "event": "app.send",
      "fields": {
        "data": [
          255
        ]
      }
    },
    {
      "at_ms": 23,
      "event": "app.transmit",
      "fields": {}
    },
    {
      "at_ms": 24,
      "event": "app.push",
      "fields": {}
    },
    {
      "at_ms": 24,
      "event": "choice.segment",
      "fields": {
        "count": 3
      },
      "expect_trace": [
        {
          "at_ms": 24,
          "emitted": [
            {
              "message": "tcp_data",
              "fields": {
                "flags": "A",
                "seq": 1001,
                "ack": 9001,
                "window": 16,
                "payload": [
                  0,
                  128,
                  255
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "at_ms": 30,
      "event": "net.ack",
      "fields": {
        "seq": 9001,
        "ack": 1004,
        "window": 16
      }
    },
    {
      "at_ms": 40,
      "tick": true,
      "expect_trace": []
    }
  ],
  "expect": {
    "state": "ESTABLISHED",
    "variables": {
      "cb_acked_total": 3,
      "svc_acked_bytes": 3,
      "snd_buf": [],
      "rtx_buf": [],
      "sws_push_bytes": 0,
