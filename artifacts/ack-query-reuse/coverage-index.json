          "kind": "modeling_choice",
          "strength": "explicit bounded segment provenance"
        },
        "CB-CREDIT": {
          "source": "spec/sources/tcp-sent-ledger.json",
          "interpretation": "Pinned lwIP2.2.1 tcp_free_acked_segments releases complete original segments; recv_acked is reported through the public sent callback once per input in this <=16-byte scope. This optional service projection retires every whole segment covered by accepted cumulative ACK, not each newly ACKed byte. It is implementation-policy modeling, not a normative TCP callback requirement.",
          "kind": "modeling_choice",
          "strength": "whole-original-segment sent credit"
        },
        "CB-ACK": {
          "source": "spec/sources/rfc9293.txt",
          "interpretation": "August2022 sections3.4/3.10.7.4: cumulative sequence-space acknowledgments are inherited unchanged. TCP byte credit and implementation callback credit are different observables. Accepted data ACK credit gates retirement; future/old/duplicate ACKs cannot fabricate callbacks.",
          "kind": "modeling_choice",
          "strength": "shared sequence/ACK semantics"
        },
        "CB-SCOPE": {
          "source": "docs/tcp-sent-ledger.md",
          "interpretation": "cb_step_bytes is an explicit IR service observation, not a Python protocol callback. Metadata tracks at most one new-data emission per atomic rule and fails an invariant on overflow. Fixed source/witness replays and real public C callbacks do not prove general TCP, socket semantics, Nagle/SWS or translator/implementation refinement.",
          "kind": "modeling_choice",
          "strength": "bounded observability scope"
        }
      },
